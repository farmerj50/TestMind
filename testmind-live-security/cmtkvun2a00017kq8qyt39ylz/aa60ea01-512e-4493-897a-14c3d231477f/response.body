    <style id="loader-styles">
      .isp-2{
          background-color: rgba(0,0,0,0.2);
          position: fixed;
          top: 0;
          bottom: 0;
          left: 0;
          right: 0;
          z-index: 1;
      }

      .e-loader-ph {
          height: 30px;
          left: 50%;
          margin-left: -15px;
          margin-top: -15px;
          position: absolute;
          top: 50%;
          width: 30px;
          z-index: 9999999;
          background-color: #fff;
          border-radius: 5px;
          display: flex;
          align-items: center;
          justify-content: center;
      }

      @keyframes rotation {
        100% { transform: rotate(1turn); }
      }

      .ets-indeterminate-loader.ets-loader-xlarge {
          aspect-ratio: 1;
          border-radius: 50%;
          width: 30px;
          animation: rotation 1s infinite linear;
          background:
              radial-gradient(farthest-side, #878DA1 94%, #0000) top/4px 4px no-repeat,
              radial-gradient(farthest-side, #878DA1 94%, #0000) left/4px 4px no-repeat,
              conic-gradient(#E4E7F0 75%, #878DA1 76%, #878DA1);
          -webkit-mask: radial-gradient(farthest-side, #0000 calc(100% - 4px), #000 0);
          mask: radial-gradient(farthest-side, #0000 calc(100% - 4px), #000 0);
      }

      /* Dialog-only mask for the eToro-Plus RN WebView host (toggled via window.eToroDialogOnly). */
      body[data-dialog-only="true"] {
          background-color: var(--neutral-primary-bg);
      }
      body[data-dialog-only="true"] > *:not(.cdk-overlay-container):not(script):not(noscript) {
          visibility: hidden !important;
          pointer-events: none !important;
      }
    </style>
