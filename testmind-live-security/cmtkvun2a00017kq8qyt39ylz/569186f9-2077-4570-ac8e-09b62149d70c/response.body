torostatic.com/avatars/35X35/12276068/4.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/12276068/4.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/12276068/4.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":79,"piLevel":2},"parent":{"id":"a5a6a470-a68c-11f1-8080-8001364801a1","obsoleteId":"a5a6a470-a68c-11f1-8080-8001364801a1","type":"Post"},"created":"2026-09-02T12:55:45.137Z"}]}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":true,"isOwner":false},"summary":{"totalCommentsAndReplies":0,"sharedCount":0}},{"id":"30573590-a68c-11f1-8080-8000285061d6","post":{"id":"30573590-a68c-11f1-8080-8000285061d6","owner":{"id":"318149","username":"eToroTeam","firstName":"eToro","lastName":"Team","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/918269/11.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/918269/11.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/918269/11.jpg"},"roles":["eTorian","Analyst","Verified","Regular","Admin","Moderator","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":250,"piLevel":0},"obsoleteId":"5b10bb21-a126-4e9d-bc18-6e5df1aa2ac2","created":"2026-09-02T05:07:26.185Z","message":{"text":"🚨 𝐈𝐦𝐩𝐨𝐫𝐭𝐚𝐧𝐭 𝐍𝐨𝐭𝐢𝐜𝐞 - 𝐃𝐞𝐥𝐢𝐬𝐭𝐢𝐧𝐠 of the following stocks due to a merger/acquisition (M&A):\n\n● NCS Multistage Holdings Inc - $NCSM\n● Crinetics Pharmaceuticals Inc - $CRNX\n\nThe above-mentioned stocks were recently involved in a merger/acquisition and will be delisted from the exchange.\n\nA merger involves the combination of two companies into a single new entity. Various types of mergers are executed for different reasons, such as expanding a company's presence in new sectors or gaining market share. The ultimate goal behind such mergers and acquisitions is to enhance shareholder value.\n\nIf the aforementioned stock is the acquired party, then it will be delisted from the platform, and positions will be closed at the average liquidation price. If the aforementioned stock is the acquirer, it will continue to be offered on our platform.\n\nPlease be aware that corporate actions may be subject to changes.\n\nTo review your account portfolio and stay informed about any updates, please click here: https://www.etoro.com/portfolio/overview\n\n\nThank you,\n\nThe eToroTeam","languageCode":"en-gb"},"updated":"2026-09-02T05:07:26.185Z","isDeleted":false,"type":"Default","metadata":{},"attachments":[{"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/d5a5076f-7876-4080-8703-7577b9afb991-2026-09-02.png","host":"openbook-static-files-prod.s3.amazonaws.com","mediaType":"Image","media":{"image":{"width":1200,"height":628,"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/d5a5076f-7876-4080-8703-7577b9afb991-2026-09-02.png"},"video":{"videoSource":"None","image":{"width":0,"height":0}}}}],"tags":[{"market":{"id":"9800","symbolName":"CRNX","displayName":"Crinetics Pharmaceuticals Inc","updated":"2026-08-23T13:43:05.339Z","assetType":"Stocks","internalId":9800,"avatar":{"small":"https://etoro-cdn.etorostatic.com/market-avatars/9800/35x35.png","medium":"https://etoro-cdn.etorostatic.com/market-avatars/9800/50x50.png","large":"https://etoro-cdn.etorostatic.com/market-avatars/9800/150x150.png","svg":{"url":"https://etoro-cdn.etorostatic.com/market-avatars/9800/9800_1A8A9E_F7F7F7.svg","backgroundColor":"#1A8A9E","textColor":"#F7F7F7"}},"application":"eToro","metadata":"","assetTypeId":5,"assetTypeSubCategoryId":0}}],"isSpam":false,"editStatus":"None"},"commentsData":{"reactionPaging":{"totalCount":0},"comments":[]},"emotionsData":{"like":{"paging":{"totalCount":3},"emotions":[{"type":"Like","id":"like_30573590-a68c-11f1-8080-8000285061d6_21621228","owner":{"id":"21621228","username":"Cally78uk","firstName":"Brian","lastName":"Mc Allister","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/21337800/1.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/21337800/1.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/21337800/1.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":218,"piLevel":2},"parent":{"id":"30573590-a68c-11f1-8080-8000285061d6","obsoleteId":"30573590-a68c-11f1-8080-8000285061d6","type":"Post"},"created":"2026-09-02T16:14:43.084Z"},{"type":"Like","id":"like_30573590-a68c-11f1-8080-8000285061d6_43207807","owner":{"id":"43207807","username":"skyholding25","firstName":"Alessandro","lastName":"Sakyi Alfred","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/43077387/4.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/43077387/4.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/43077387/4.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":102,"piLevel":2},"parent":{"id":"30573590-a68c-11f1-8080-8000285061d6","obsoleteId":"30573590-a68c-11f1-8080-8000285061d6","type":"Post"},"created":"2026-09-02T16:13:20.578Z"},{"type":"Like","id":"like_30573590-a68c-11f1-8080-8000285061d6_12564565","owner":{"id":"12564565","username":"FxTradeFx","firstName":"Lars","lastName":"Nietzschmann","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/12276068/4.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/12276068/4.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/12276068/4.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":79,"piLevel":2},"parent":{"id":"30573590-a68c-11f1-8080-8000285061d6","obsoleteId":"30573590-a68c-11f1-8080-8000285061d6","type":"Post"},"created":"2026-09-02T12:55:46.65Z"}]}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":true,"isOwner":false},"summary":{"totalCommentsAndReplies":0,"sharedCount":0},"additionalData":{"reliableRecAiAssets":[{"assetId":1050735,"score":1.0},{"assetId":9800,"score":1.0}]}},{"id":"33197f50-a68b-11f1-8080-8000365bf8cc","post":{"id":"33197f50-a68b-11f1-8080-8000365bf8cc","owner":{"id":"318149","username":"eToroTeam","firstName":"eToro","lastName":"Team","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/918269/11.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/918269/11.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/918269/11.jpg"},"roles":["eTorian","Analyst","Verified","Regular","Admin","Moderator","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":250,"piLevel":0},"obsoleteId":"efdf193d-e2a6-41f5-85b3-3a57ca556bc4","created":"2026-09-02T05:00:21.317Z","message":{"text":"Please note, there has been a reverse stock split on the following stock:\n\n● Nuburu Inc - $BURU\nThe ratio for the split is 1 for 40\n\n\n👉 What is a reverse stock split?\n\nA reverse split is a market event where a company decides to consolidate its existing shares into fewer, proportionally more valuable, shares. The process involves a company reducing the total number of its outstanding shares in the open market according to a certain ratio. For example: if the split ratio is 1:2, then for every two shares previously held, shareholders would now hold a single share. Subsequently, the price of the share is also adjusted according to the same ratio in order to maintain the same overall value.\n\n👉 How do we respond to a stock split?\n\nOur policy in response to a split is to adjust the opening rate of the positions in question to reflect the new rates. This also ensures that all subsequent profit calculations are proportionately correct.\n\nPlease be aware that any price changes for the above-mentioned stock, as well as changes in holdings of units, are due to this adjustment. 🔊\n\nTo sum it up, the price of the asset and the number of units on the positions may change, but the value of all relevant positions remains the same.\n\n\nThank you,\n\nThe eToroTeam","languageCode":"en-gb"},"updated":"2026-09-02T05:00:21.317Z","isDeleted":false,"type":"Default","metadata":{},"attachments":[{"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/ed5b8a60-3bb7-4aa2-aa62-90826c754abe-2026-09-02.png","host":"openbook-static-files-prod.s3.amazonaws.com","mediaType":"Image","media":{"image":{"width":1200,"height":628,"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/ed5b8a60-3bb7-4aa2-aa62-90826c754abe-2026-09-02.png"},"video":{"videoSource":"None","image":{"width":0,"height":0}}}}],"isSpam":false,"editStatus":"None"},"commentsData":{"reactionPaging":{"totalCount":0},"comments":[]},"emotionsData":{"like":{"paging":{"totalCount":3},"emotions":[{"type":"Like","id":"like_33197f50-a68b-11f1-8080-8000365bf8cc_43207807","owner":{"id":"43207807","username":"skyholding25","firstName":"Alessandro","lastName":"Sakyi Alfred","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/43077387/4.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/43077387/4.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/43077387/4.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":102,"piLevel":2},"parent":{"id":"33197f50-a68b-11f1-8080-8000365bf8cc","obsoleteId":"33197f50-a68b-11f1-8080-8000365bf8cc","type":"Post"},"created":"2026-09-02T16:13:52.244Z"},{"type":"Like","id":"like_33197f50-a68b-11f1-8080-8000365bf8cc_12564565","owner":{"id":"12564565","username":"FxTradeFx","firstName":"Lars","lastName":"Nietzschmann","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/12276068/4.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/12276068/4.jpg","large