  <script type="text/javascript">
    var ajaxurl = "https://blogs.mathworks.com/wp-admin/admin-ajax.php";
  </script>
  <script src="/js/jquery.cookie.js"></script>

  <script>$(document).ready(function() {
  var type = 'post_date';
  function load_posts(){
    var count = $('.post-card').length + 1;
    var type = 'post_date';
    var blogger_profile = {
      "Stuart McGarrity": "https://www.mathworks.com/matlabcentral/profile/authors/512264",
      "Jiro Doke": "https://www.mathworks.com/matlabcentral/profile/authors/869871",
      "Pick of the Week Team": "https://www.mathworks.com/matlabcentral/profile/authors/38777948",
      "Ned Gulley": "https://www.mathworks.com/matlabcentral/profile/authors/140947",
      "Loren Shure": "https://www.mathworks.com/matlabcentral/profile/authors/136425",
      "Guy Rouleau": "https://www.mathworks.com/matlabcentral/profile/authors/1248313",
      "Steve Eddins": "https://www.mathworks.com/matlabcentral/profile/authors/476476",
      "Cleve Moler": "https://www.mathworks.com/matlabcentral/profile/authors/349729",
      "Andy Campbell": "https://www.mathworks.com/matlabcentral/profile/authors/869911",
      "Lisa Harvey": "https://www.mathworks.com/matlabcentral/profile/authors/6768264",
      "Hans Scharler": "https://www.mathworks.com/matlabcentral/profile/authors/5863695",
      "Tanya Kuruvilla": "https://www.mathworks.com/matlabcentral/profile/authors/19134778",
      "Johanna Pingel": "https://www.mathworks.com/matlabcentral/profile/authors/4758135",
      "Michio Inoue": "https://www.mathworks.com/matlabcentral/profile/authors/5397765",
      "Madeline Carleton": "https://www.mathworks.com/matlabcentral/profile/authors/10446609",
      "Mike Croucher": "https://www.mathworks.com/matlabcentral/profile/authors/20789457",
      "YJ Lim":"https://www.mathworks.com/matlabcentral/profile/authors/12556787",
      "Ciara McGahey": "https://www.mathworks.com/matlabcentral/profile/authors/38006951",
      "Alex Roumi": "https://www.mathworks.com/matlabcentral/profile/authors/15622536",
      "Adam Danz":"https://www.mathworks.com/matlabcentral/profile/authors/25613423",
      "Cristian Macario":"https://www.mathworks.com/matlabcentral/profile/authors/14080662",
      "Ganesh Rathinavel":"https://www.mathworks.com/matlabcentral/profile/authors/13753988",
      "Kirsten McCane":"https://www.mathworks.com/matlabcentral/profile/authors/22057189",
      "Jason Ghidella":"https://www.mathworks.com/matlabcentral/profile/authors/3473",
      "George Amarantidis":"https://www.mathworks.com/matlabcentral/profile/authors/24225340"
    };
    data = { action: "more_post_ajax", count: count, type: type};
    jQuery.ajax({
        url: ajaxurl,
        data: data,
        dataType: 'json',
        type: 'post',
        success: function(response) {
          var data = response;
          $.each(data, function(i, item){
            var profile_link = blogger_profile[item.author];
            var commentlink = item.comment;
            var updatecommentlink = commentlink.replace("?#view_comments", "?#view_comments");
            var catelink = item.category;
            var updatecatlink = catelink.replace("?", "?");
            var updatecatlink = updatecatlink.replace("Category:", "Category:");
            var post_card = '<div class="col-xs-12 col-sm-6 col-md-4 add_margin_20 posts extra-posts"><div class="post-card"><div class="card_media add_margin_5"><a href="' + item.url + '&" title="' + item.url + '" rel="bookmark"><img alt="'+item.full_title+'" class="img-responsive" src="' + item.thumb + '" onError="this.onerror=null; this.src=\'/wp-content/themes/mathworks_1.0/images/placeholder_'+item.blog_id+'.jpg\';"></a></div><div class="card_body"><div class="panel"><div class="panel-body"><h1 class="post-title"><a href="' + item.url + '&" title="' + item.url + '" rel="bookmark">' + item.full_title + '</a>' + updatecommentlink + '</h1><p class="post-content">' + item.content + '...</p><div class="post-category">' + updatecatlink + ' </div></div></div></div></div><div class="post-card-footer add_border_top"><div class="media post-meta-data"><div class="media-left"><a href="'+item.blog_url+'/" title="'+ item.blog_name +'"><img class="bloger_sm_avatar" src="/wp-content/themes/mathworks_1.0/images/color_'+item.blog_id+'.png" /></a></div><div class="media-body"><div class="meta-left"><p class="blogger-name"><a class="author_inline" data-locale-id="en" href="'+profile_link+'">' + item.author + '</a> on '+item.post_date+'</p><p class="blog-site"><a href="'+item.blog_url+'/">' + item.blog_name + '</a></p></div></div></div></div></div>';
            $("#ajax-posts").append(post_card);
          });
          $("#more_posts").attr("disabled",false);
          $("#more_posts").removeClass("active");
        },
        error : function(jqXHR, textStatus, errorThrown) {
            console.log('fail to load more posts');
        }
    });
  }
  $("#more_posts").on("click",function(){
    $("#more_posts").attr("disabled",true);
    $(this).toggleClass('active');
    load_posts();
    $('.author_inline').unbind().click(function(e){
	  cardGenerate(e);
    });
  });
 });
</script>    <link type="text/css" rel="stylesheet" href="/wp-content/themes/mathworks_1.0/style.css?v2.2" />
