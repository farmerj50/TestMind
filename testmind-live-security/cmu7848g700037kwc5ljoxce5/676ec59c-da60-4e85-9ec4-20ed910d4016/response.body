    contentElement.insertAdjacentHTML('beforeend', '          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184942-using-a-pesonal-single-matlab-license-on-a-cyclecloud-cluster-by-subitting-a-slurm-job/?s_tid=ans_lp_feed_leaf\">Using a Pesonal single Matlab license on a cyclecloud Cluster by subitting a slurm job<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/39356446\'>\n                        <img alt=\"Roberto\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/39356446\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/39356446\'>Roberto<\/a> \n                        on 18 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hi there, I have a user ( I am sys admin) whos asked me to use an HPC (implemented on Azure==CycleCloud). He would like to submit jobs to the cluster so that the instances created by Azure can authenticate using his MW_USERNAME MW_PASSWORD relate...<\/p>\n                  <div class=\"search_result_meta answer-tag-list tags_ans_lp\">\n                    <strong>Tags<\/strong>: \n                    <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22hpc%22\">hpc<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22matlab%22\">matlab<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22authentication%22\">authentication<\/a>\n                  <\/div>\n                  <div class=\"search_result_meta feed_stats\">\n                    <ul class=\"list-inline -has_list_separators\">\n                      <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n                      <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 0<\/li>  \n                      <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comments\"><\/span> 0<\/li>                          \n                    <\/ul>\n                  <\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\">\n                  <div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\">\n                    <div class=\"answers_meta\" data-bs-toggle=\"tooltip\" data-bs-title=\"0 Answers\">\n                      <span class=\"answers_meta_count\">0<\/span>\n                      <span class=\"answers_meta_label\">answers<\/span>\n                    <\/div>           \n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184941-when-will-roadrunner-be-available-for-purchase-students-again/?s_tid=ans_lp_feed_leaf\">When will RoadRunner be available for purchase/students again?<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/42450770\'>\n                        <img alt=\"Faisal\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/42450770\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/42450770\'>Faisal<\/a> \n                        on 18 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> RoadRunner appears to be closed for purchase, including student licensing. Could someone confirm when it will reopen for new purchases/student access?<\/p>\n                  <div class=\"search_result_meta answer-tag-list tags_ans_lp\">\n                    <strong>Tags<\/strong>: \n                    <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22roadrunner%22\">roadrunner<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22licensing%22\">licensing<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22purchase%22\">purchase<\/a>\n                  <\/div>\n                  <div class=\"search_result_meta feed_stats\">\n                    <ul class=\"list-inline -has_list_separators\">\n                      <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n                      <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 13<\/li>  \n                      <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comments\"><\/span> 0<\/li>                          \n                    <\/ul>\n                  <\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\">\n                  <div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\">\n                    <div class=\"answers_meta\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Answer\">\n                      <span class=\"answers_meta_count\">1<\/span>\n                      <span class=\"answers_meta_label\">answer<\/span>\n                    <\/div>           \n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184940-how-to-enable-multi-threading-or-maximize-cpu-usage-for-a-single-channel-run-in-serial-link-designer/?s_tid=ans_lp_feed_leaf\">How to enable multi-threading or maximize CPU usage for a single-channel run in Serial Link designer<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/40195199\'>\n                        <img alt=\"HAODA\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/40195199\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/40195199\'>HAODA<\/a> \n                        on 18 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I am executing a channel simulation with no variable or corner sweeps enabled. However, I noticed that CPU utilization is very low and the simulation runtime is long. Is there any configuration or environment setting available to enable multi-thr...<\/p>\n                  <div class=\"search_result_meta answer-tag-list tags_ans_lp\">\n                    <strong>Tags<\/strong>: \n                    <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22serial+link+designer%22\">serial link designer<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22time+domain+eye+simulation%22\">time domain eye simulation<\/a>\n                  <\/div>\n                  <div class=\"search_result_meta feed_stats\">\n                    <ul class=\"list-inline -has_list_separators\">\n                      <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n                      <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 0<\/li>  \n                      <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comments\"><\/span> 0<\/li>                          \n                    <\/ul>\n                  <\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\">\n                  <div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\">\n                    <div class=\"answers_meta\" data-bs-toggle=\"tooltip\" data-bs-title=\"0 Answers\">\n                      <span class=\"answers_meta_count\">0<\/span>\n                      <span class=\"answers_meta_label\">answers<\/span>\n                    <\/div>           \n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184939-is-it-possible-to-print-results-from-appdesigner-using-matlab-2018/?s_tid=ans_lp_feed_leaf\">Is it possible to print results from appdesigner, using Matlab 2018?<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/11571852\'>\n                        <img alt=\"Muazma Ali\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/11571852\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/11571852\'>Muazma Ali<\/a> \n                        on 18 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hi! I am trying to find out how I can print out results from my app designer window. I am unsure whether I can use the export function as I have Matlab 2018.<\/p>\n                  <div class=\"search_result_meta answer-tag-list tags_ans_lp\">\n                    <strong>Tags<\/strong>: \n                    <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22print%22\">print<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22matlab+2018%22\">matlab 2018<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22appdesigner%22\">appdesigner<\/a>\n                  <\/div>\n                  <div class=\"search_result_meta feed_stats\">\n                    <ul class=\"list-inline -has_list_separators\">\n                      <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n                      <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 39<\/li>  \n                      <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comments\"><\/span> 4<\/li>                          \n                    <\/ul>\n                  <\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\">\n                  <div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\">\n                    <div class=\"answers_meta\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Answer\">\n                      <span class=\"answers_meta_count\">1<\/span>\n                      <span class=\"answers_meta_label\">answer<\/span>\n                    <\/div>           \n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184938-stm32-fdcan-example-conflicting-settings-for-bitrate-switching/?s_tid=ans_lp_feed_leaf\">STM32 FDCAN Example: conflicting settings for bitrate switching?<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/38271327\'>\n                        <img alt=\"Ali Reza\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/38271327\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/38271327\'>Ali Reza<\/a> \n                        on 18 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello, I\'ve been trying to setup and test CAN-FD communication (with bitrate switching) between two STM32 microcontrollers with a built-in CAN-FD peripheral, and started by following this example from Mathworks. The example sets the CAN-FD timing...<\/p>\n                  <div class=\"search_result_meta answer-tag-list tags_ans_lp\">\n                    <strong>Tags<\/strong>: \n                    <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22simulink%22\">simulink<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22embedded+coder%22\">embedded coder<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22stm32%22\">stm32<\/a>\n                  <\/div>\n                  <div class=\"search_result_meta feed_stats\">\n                    <ul class=\"list-inline -has_list_separators\">\n                      <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n                      <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 11<\/li>  \n                      <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comment\"><\/span> 1<\/li>                          \n                    <\/ul>\n                  <\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\">\n                  <div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\">\n                    <div class=\"answers_meta\" data-bs-toggle=\"tooltip\" data-bs-title=\"0 Answers\">\n                      <span class=\"answers_meta_count\">0<\/span>\n                      <span class=\"answers_meta_label\">answers<\/span>\n                    <\/div>           \n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n              <div class=\"panel panel-default panel_sidebar -left lp-share-card search_result add_padding_0\">\n  <div class=\"panel-body w-100 add_border_color_orange\">\n    <p class=\"category_label share_section add_font_color_orange\"><strong>SHARE YOUR KNOWLEDGE<\/strong><\/p>\n    <p class=\"add_margin_12\"><span id=\"share_help\">Help<\/span> <a class=\"author_inline analyticsMlcProfileModal\" data-locale-id=\"en\" href=\"/matlabcentral/profile/authors/38238855\">Marija<\/a>\n\n<\/p>\n    <p class=\"h3 share_question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184557-why-do-i-receive-mathworks-error-5201\">Why do I receive MathWorks Error 5201?<\/a><\/p>\n    <div class=\"d-flex flex-row\">\n      <div class=\"search_result_content\">\n        <p class=\"share_body text-wrap d-none d-md-block search_result_desc\">I am using a Campus-Wide License from the University of Belgrade. The online installer completes, but MATLAB immediately shows error 5201 on first launch. MathWorksServiceHost.exe is missing, and the \"MathWorks Service Host\" Windows service is not installed. I have already reinstalled MATLAB seve...<\/p>\n        <div class=\"d-flex flex-row align-items-center gap-3 flex-wrap\">\n          <div class=\"search_result_meta add_margin_0 feed_stats flex-grow-1\">\n            <ul class=\"list-inline -has_list_separators\">\n              <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n              <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 30<\/li>\n              <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comments\"><\/span> 3<\/li>                         \n            <\/ul>\n          <\/div>\n          <div class=\"d-flex flex-row flex-nowrap align-items-center ms-auto gap-3\">\n            <p class=\"search_result_meta add_margin_0\"><a id=\"answer_all\" href=\"/matlabcentral/answers/answer/?s_tid=ans_lp_unanswered\">View all unanswered questions<\/a><\/p>\n            <p class=\"search_result_meta add_margin_0\"><a id=\"answer_this\" href=\"/matlabcentral/answers/2184557-why-do-i-receive-mathworks-error-5201/?s_tid=ans_lp_share\" class=\"btn btn_color_blue btn-block add_padding_10\">Answer this question<\/a><\/p>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>\n\n          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184937-in-an-r2024b-mbd-safety-process-requirements-test-coverage-embedded-coder-iec-certification-kit/?s_tid=ans_lp_feed_leaf\">In an R2024b MBD safety process (Requirements, Test, Coverage, Embedded Coder, IEC Certification Kit), what is the recommended workflow to qualify tools, generate requirements<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/37340348\'>\n                        <img alt=\"Nour Eddine\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/37340348\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/37340348\'>Nour Eddine<\/a> \n                        on 18 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello , I am setting up an MBD safety process (ISO 26262) with the following toolchain in R2024b: Requirements Toolbox (Req_MBD_Process.slreqx) Simulink Test (test.mldatx) Simulink Coverage (model and generated code coverage, including MC/DC) Emb...<\/p>\n                  <div class=\"search_result_meta answer-tag-list tags_ans_lp\">\n                    <strong>Tags<\/strong>: \n                    <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22iec+toolkit%22\">iec toolkit<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22mbd+process%22\">mbd process<\/a>\n                  <\/div>\n                  <div class=\"search_result_meta feed_stats\">\n                    <ul class=\"list-inline -has_list_separators\">\n                      <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n                      <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 0<\/li>  \n                      <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comments\"><\/span> 0<\/li>                          \n                    <\/ul>\n                  <\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\">\n                  <div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\">\n                    <div class=\"answers_meta\" data-bs-toggle=\"tooltip\" data-bs-title=\"0 Answers\">\n                      <span class=\"answers_meta_count\">0<\/span>\n                      <span class=\"answers_meta_label\">answers<\/span>\n                    <\/div>           \n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184936-why-i-can-t-run-my-simulink-model-after-i-train-my-reinforce-learning-agent/?s_tid=ans_lp_feed_leaf\">Why i can‘t run my simulink model after i train my reinforce-learning agent<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/27547331\'>\n                        <img alt=\"靖璋\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/27547331\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/27547331\'>靖璋<\/a> \n                        on 18 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> 我训练完了我的强化学习智能体之后再返回simulink模型，我正准备用训练好的agent来测试一下性能，但是我的simulink模型居然连100s都跑不完了，一直卡在这个界面，这是为什么？<\/p>\n                  <div class=\"search_result_meta answer-tag-list tags_ans_lp\">\n                    <strong>Tags<\/strong>: \n                    <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22simulink%EF%BC%8Crl%22\">simulink，rl<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22sac%22\">sac<\/a>\n                  <\/div>\n                  <div class=\"search_result_meta feed_stats\">\n                    <ul class=\"list-inline -has_list_separators\">\n                      <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n                      <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 0<\/li>  \n                      <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comments\"><\/span> 0<\/li>                          \n                    <\/ul>\n                  <\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\">\n                  <div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\">\n                    <div class=\"answers_meta\" data-bs-toggle=\"tooltip\" data-bs-title=\"0 Answers\">\n                      <span class=\"answers_meta_count\">0<\/span>\n                      <span class=\"answers_meta_label\">answers<\/span>\n                    <\/div>           \n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184932-problem-updating-polyspace-to-r2019a-update9/?s_tid=ans_lp_feed_leaf\">Problem updating Polyspace to R2019a Update9<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/42434388\'>\n                        <img alt=\"Florin\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/42434388\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/42434388\'>Florin<\/a> \n                        on 17 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello, I face a problem documented here: Bug Reports 2052543 , when I run Polyspace I always get into that error. Based on the description there I have to update to R2019a Update 6. I downloaded version R2019a Update 9 (18 Sep 2020), installed it...<\/p>\n                  <div class=\"search_result_meta answer-tag-list tags_ans_lp\">\n                    <strong>Tags<\/strong>: \n                    <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22polyspace%22\">polyspace<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22update%22\">update<\/a>\n                  <\/div>\n                  <div class=\"search_result_meta feed_stats\">\n                    <ul class=\"list-inline -has_list_separators\">\n                      <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n                      <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 46<\/li>  \n                      <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comments\"><\/span> 4<\/li>                          \n                    <\/ul>\n                  <\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\">\n                  <div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\">\n                    <div class=\"answers_meta\" data-bs-toggle=\"tooltip\" data-bs-title=\"0 Answers\">\n                      <span class=\"answers_meta_count\">0<\/span>\n                      <span class=\"answers_meta_label\">answers<\/span>\n                    <\/div>           \n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184931-how-to-access-elements-with-same-field-names-in-an-array-of-structures-without-using-a-loop/?s_tid=ans_lp_feed_leaf\">How to access elements with same field names in an array of structures without using a loop?<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/17012588\'>\n                        <img alt=\"Wassili Dimitriew\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/17012588\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/17012588\'>Wassili Dimitriew<\/a> \n                        on 17 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello, Assume we have a cell array of structures: a.name = \'first\'; b.name = \'second\'; c.name = \'third\'; s = {a; b; c}; Now I want to change the values of fields \"name\" in some specific structures, for example, in 1 and 3. I know how to do it usi...<\/p>\n                  <div class=\"search_result_meta answer-tag-list tags_ans_lp\">\n                    <strong>Tags<\/strong>: \n                    <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22struct%22\">struct<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22for+loop%22\">for loop<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22cell+array%22\">cell array<\/a>\n                  <\/div>\n                  <div class=\"search_result_meta feed_stats\">\n                    <ul class=\"list-inline -has_list_separators\">\n                      <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n                      <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 64<\/li>  \n                      <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comments\"><\/span> 3<\/li>                          \n                    <\/ul>\n                  <\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\">\n                  <div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\">\n                    <div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 1 Answer\">\n                      <span class=\"answers_meta_count\">2<\/span>\n                      <span class=\"answers_meta_label\">answers<\/span>\n                    <\/div>           \n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184929-why-does-readbinblock-function-return-incomplete-data-or-crash-matlab-when-reading-large-waveform/?s_tid=ans_lp_feed_leaf\">Why does \"readbinblock\" function return incomplete data or crash MATLAB when reading large waveform data from a TCP/IP instrument using NI-VISA driver?<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/4455340\'>\n                        <img alt=\"MathWorks Instrument Control Toolbox Team\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/4455340\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/4455340\'>MathWorks Instrument Control Toolbox Team<\/a> \n                        on 17 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> When reading large chunks of data from an instrument over a TCP/IP VISA connection (for example, a VXI-11 resource such as TCPIP0::&lt;IP-address&gt;::inst0::INSTR), readbinblock or read function execution does not complete successfully and I see one o...<\/p>\n                  <div class=\"search_result_meta answer-tag-list tags_ans_lp\">\n                    <strong>Tags<\/strong>: \n                    <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22ni-visa%22\">ni-visa<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22vxi-11%22\">vxi-11<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22instrument+control+toolbox%22\">instrument control toolbox<\/a>\n                  <\/div>\n                  <div class=\"search_result_meta feed_stats\">\n                    <ul class=\"list-inline -has_list_separators\">\n                      <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n                      <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 10<\/li>  \n                      <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comments\"><\/span> 0<\/li>                          \n                    <\/ul>\n                  <\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\">\n                  <div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\">\n                    <div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\">\n                      <span class=\"answers_meta_count\">1<\/span>\n                      <span class=\"answers_meta_label\">answer<\/span>\n                    <\/div>           \n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184928-how-to-reduce-compilation-time-for-a-model-with-around-2-000-model-reference-blocks/?s_tid=ans_lp_feed_leaf\">How to reduce compilation time for a model with around 2,000 Model Reference blocks?<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/41923355\'>\n                        <img alt=\"Rajkoti\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/41923355\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/41923355\'>Rajkoti<\/a> \n                        on 17 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hi everyone, We have a Simulink template model that contains around 2,000 Model Reference blocks. We have two requirements: Reduce the Ctrl+D compilation/update time. Hide the actual implementation before delivering the model to the supplier. To ...<\/p>\n                  <div class=\"search_result_meta answer-tag-list tags_ans_lp\">\n                    <strong>Tags<\/strong>: \n                    <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22matlab%22\">matlab<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22matlab+script%22\">matlab script<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22simulation%22\">simulation<\/a>\n                  <\/div>\n                  <div class=\"search_result_meta feed_stats\">\n                    <ul class=\"list-inline -has_list_separators\">\n                      <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n                      <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 0<\/li>  \n                      <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comments\"><\/span> 0<\/li>                          \n                    <\/ul>\n                  <\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\">\n                  <div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\">\n                    <div class=\"answers_meta\" data-bs-toggle=\"tooltip\" data-bs-title=\"0 Answers\">\n                      <span class=\"answers_meta_count\">0<\/span>\n                      <span class=\"answers_meta_label\">answers<\/span>\n                    <\/div>           \n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184930-how-do-i-use-connectcallback-and-getcallbackdataforsignal-to-access-live-streaming-signal-data-i/?s_tid=ans_lp_feed_leaf\">How do I use \"connectCallback\" and \"getCallbackDataForSignal\" to access live-streaming signal data in my MATLAB code or Simulink Real-Time app in R2020b and later?<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/4622813\'>\n                        <img alt=\"MathWorks Support Team\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/4622813\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/4622813\'>MathWorks Support Team<\/a> \n                        on 17 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I use Simulink Real-Time (SLRT) and would like to stream signal data from the real-time application running on my Speedgoat target back to MATLAB using&amp;amp;nbsp;slrealtime.Instrument objects. I am trying to use&amp;amp;nbsp;connectCallback to registe...<\/p>\n                  <div class=\"search_result_meta answer-tag-list tags_ans_lp\">\n                    <strong>Tags<\/strong>: \n                    <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22slrealtime.instrument%22\">slrealtime.instrument<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22connectcallback%22\">connectcallback<\/a><span class=\"separator\"><\/span> <a rel=\"nofollow\" href=\"/matlabcentral/answers/?term=tag%3A%22getcallbackdataforsignal%22\">getcallbackdataforsignal<\/a>\n                  <\/div>\n                  <div class=\"search_result_meta feed_stats\">\n                    <ul class=\"list-inline -has_list_separators\">\n                      <li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span> 0<\/li>\n                      <li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span> 0<\/li>  \n                      <li class=\"list-inline-item\"><span class=\"icon-comment feed_comments\" aria-label=\"comments\"><\/span> 0<\/li>                          \n                    <\/ul>\n                  <\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\">\n                  <div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\">\n                    <div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\">\n                      <span class=\"answers_meta_count\">1<\/span>\n                      <span class=\"answers_meta_label\">answer<\/span>\n                    <\/div>           \n                  <\/div>\n                <\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n          <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n            <div class=\"panel-body w-100\">\n              <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"/matlabcentral/answers/2184926-plotting-images-in-matlab-2026a/?s_tid=ans_lp_feed_leaf\">Plotting images in Matlab 2026a<\/a><\/p>\n              <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                  <div class=\"post_meta search_result_meta\">\n                    <div class=\"d-flex align-items-center\">\n                      <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/15959472\'>\n                        <img alt=\"Louise Wilson\" class=\"rounded-circle community_profile_image\" src=\"/responsive_image/75/75/0/0/0/profile/15959472\" width=\"24\" onerror=\"img_not_found(this, \'/responsive_image/100/0/0/0/0/cache/matlabcentral/profiles/profilepic_default.gif\');\"><\/img><\/a>\n                      <\/div>\n                      <div class=\"flex-grow-1 ms-2\">\n                        <a class=\"author_inline\" data-locale-id=\"en\" href=\'/matlabcentral/profile/authors/15959472\'>Louise Wilson<\/a> \n                        on 16 Sep 2026                        \n                      <\/div>\n                    <\/div>\n                  <\/div>\n                  <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I frequently work with large matrices and usually I can use pcolor to plot these - but since I updated Matlab to 2026a I get an error everytime I use the same code to do something which worked in Matlab 2024a. I can\'t share my data, 