<h1 class="r2026a" itemprop="content title">Documentation</h1><p class="text-end small small_90" id="link-below-logo"></p><div class="row d-none" id="list_topmatter"><div class="col-12 col-sm-5 col-lg-4"><form><div class="mb-3"></div></form></div><div class="col-12 col-sm-6 offset-sm-1 col-lg-5 offset-lg-3"><div class="justify-content-between add_margin_20" id="listtypebutton"></div></div></div><div id="doclanding_content"><div class="row"><div class="col-12 col-sm-6 col-md-8 col-lg-9"><div class="row" id="productgroups"><div class="col-12 col-md-6" id="col1"><div id="productcard_grouping"><h2>Using MATLAB</h2><div class="panel panel-default doc_panel doc_category_panel add_background_color_gray rounded-0" id="prodgroup_matlab"><a href="matlab/index.html?s_tid=hc_panel"><div class="panel-body"><span class="pictogram-matlab pictogram_56"></span><span class="doc_panel_label">MATLAB</span></div></a></div><div class="panel panel-default doc_panel doc_category_panel add_background_color_gray rounded-0" id="prodgroup_matlab-copilot"><a href="matlab-copilot/index.html?s_tid=hc_panel"><div class="panel-body"><span class="pictogram-artificial-intelligence pictogram_56"></span><span class="doc_panel_label">MATLAB Copilot</span></div></a></div></div><div id="productcard_grouping"><h2>Using Simulink</h2><div class="panel panel-default doc_panel doc_category_panel add_background_color_gray rounded-0" id="prodgroup_simulink"><a href="simulink/index.html?s_tid=hc_panel"><div class="panel-body"><span class="pictogram-simulink pictogram_56"></span><span class="doc_panel_label">Simulink</span></div></a></div><div class="panel panel-default doc_panel doc_category_panel add_background_color_gray rounded-0" id="prodgroup_simulink-copilot"><a href="simulink-copilot/index.html?s_tid=hc_panel"><div class="panel-body"><span class="pictogram-artificial-intelligence pictogram_56"></span><span class="doc_panel_label">Simulink Copilot</span></div></a></div><div class="panel panel-default doc_pa