{"status":200,"requestId":"630af77ff5b34f419d6297027ad66c7e","client":"themathworksinc","id":{"tntId":"7fba70139bf24e4b931a545c707ab40c.34_0","marketingCloudVisitorId":"74536194091804629725748413948792422794"},"edgeHost":"mboxedge34.tt.omtrdc.net","prefetch":{},"telemetryServerToken":"p4YQxyYgYUTaezwmtUViaJ9uGl6QykMVdM+O428ZTt8=","execute":{"pageLoad":{"options":[{"content":[{"type":"customCode","selector":"HEAD","cssSelector":"","content":"<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  if (any_recommended_feed_items()) {\n    remove_recommended_feed_hidden_styles();\n  }\n  // now knowing whether the recommended feed items loaded properly or not\n  // select the appropriate feed, overriding the prior selection from the index page\n  // set cookie value to default only if invalid or nonexistant \n  var cookie_val = get_default_feed_cookie_pref();   \n  if (!is_feed_cookie_value_valid(cookie_val)) {\n    set_default_feed_cookie_pref();\n    cookie_val = get_feed_cookie_pref();\n  }\n  // if the recommended feed items did not load properly \n  // or if the activity feed does not exist (when one is logged out)\n  // then select the the appropriate feed but do not set the cookie value \n  var activity_tab = document.getElementById(\"tab_activities\");  \n  if ((cookie_val === \"Recommended\") || ((cookie_val === \"Activities\") && (activity_tab == undefined))) {\n    if (any_recommended_feed_items()) {    \n      cookie_val = \"Recommended\"\n    } else {\n      cookie_val = \"Trending\"\n    }\n  }\n  select_feed(cookie_val.toLowerCase(), true);\n});\n</script>"}],"type":"actions","responseTokens":{"profile.lastViewedEntity":"index","activity.name":"PERS_RECO_MLC-ANSWERS_WW_2026-06","profile.viewedAnswers":"[\"/matlabcentral/fileexchange/\",\"/videos.html\",\"/videos/search.html\",\"blogs index page\",\"/matlabcentral/cody\",\"/products/matlab-drive.html\",\"/support/bugreports/\",\"/matlabcentral/answers/index/\",\"homepage\",\"/search/user-center\"]","profile.ip_address":"99.61.2.250","profile.visitNumber_1":"true","geo.city":"smyrna","activity.id":"667293","profile.Three_impression_Login":"3","experience.name":"Experience B","geo.country":"united states","offer.name":"Default Content","activity.decisioningMethod":"server-side","profile.twogroups":"GroupB"},"sourceType":"target"},{"content":[{"type":"customCode","selector":"HEAD","cssSelector":"","content":"<!-- Qualaroo for mathworks.com: exit-intent -->\n<!-- Paste this code right after the <body> tag on every page of your site. -->\n<script type=\"text/javascript\">\n  var _kiq = _kiq || [];\n  (function(){\n    setTimeout(function(){\n    var d = document, f = d.getElementsByTagName('script')[0], s = d.createElement('script'); s.type = 'text/javascript';\n    s.async = true; s.src = '//s3.amazonaws.com/ki.js/49559/ahy.js'; f.parentNode.insertBefore(s, f);\n    }, 1);\n  })();\n\n_kiq.push(['set', {\n\n'TG':  'ans_recom'\n\n}]);\n  _kiq.push(['eventHandler', 'submit', function(field) {\n if (field[0].answer !== 'Visit the portal') {\n setTimeout(function() {\n _kiq.push(['stopSurvey']);\n      },1);\n    }\n  }]);\n</script>"}],"type":"actions","responseTokens":{"profile.lastViewedEntity":"index","activity.name":"PERS_RECO_MLC-ANSWERS_WW_2026-06","profile.viewedAnswers":"[\"/matlabcentral/fileexchange/\",\"/videos.html\",\"/videos/search.html\",\"blogs index page\",\"/matlabcentral/cody\",\"/products/matlab-drive.html\",\"/support/bugreports/\",\"/matlabcentral/answers/index/\",\"homepage\",\"/search/user-center\"]","profile.ip_address":"99.61.2.250","profile.visitNumber_1":"true","geo.city":"smyrna","activity.id":"667293","profile.Three_impression_Login":"3","experience.name":"Experience B","geo.country":"united states","offer.name":"Default Content","activity.decisioningMethod":"server-side","profile.twogroups":"GroupB"},"sourceType":"target"},{"content":[{"type":"setHtml","selector":"#recommended_feed_items > DIV:nth-of-type(1)","cssSelector":"#recommended_feed_items > DIV:nth-of-type(1)","content":"<div  id=\"recommendation_feed_items\" class=\"feed_items col-xs-12 add_margin_20_sm\">\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2181544-save-data-from-simulink-scope?s_tid=ans_recom_leaf\">Save data from Simulink Scope<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/25661341\">\n                                    <img alt=\"Jack Daniels\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/25661341?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/25661341\">Jack Daniels<\/a> on 28-Nov-25\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I have checked &quot;Log data to workspace&quot; in the Simulink Scope under the Logging pane, but after running the simulation, no data are saved to the workspace. Is there any additional setting required to ensure that the data are stored correctly? Thank you <\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'data workspace saving from simulink scope'&s_tid=ans_lp_tag\" rel=\"nofollow\">data workspace saving from simulink scope<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>1<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>19<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>2<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/100496-why-do-i-receive-mathworks-licensing-error-8?s_tid=ans_recom_leaf\">Why do I receive MathWorks Licensing Error 8?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">\n                                    <img alt=\"MathWorks Support Team\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4622813?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">MathWorks Support Team<\/a> on 14 June 2013\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">Why do I receive the following error: MathWorks Licensing Error 8 A licensing error occurred while trying to use &amp;lt;PRODUCTNAME&amp;gt;. The license file in use is invalid. Activate your license to get a new license file. kA0i00000007kqYCAQ 000003827<\/p>\n                    \n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>18921<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2184689-r2026a-home-insert-row-into-table-using-the-workspace-editor-arbitrary-position?s_tid=ans_recom_leaf\">R2026a Home: Insert row into table using the Workspace Editor (arbitrary position)<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/23654092\">\n                                    <img alt=\"Ravi Narasimhan\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/23654092?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/23654092\">Ravi Narasimhan<\/a> on 19 August 2026\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Using the workspace editor, I can insert a row at an arbitrary position in an array by clicking the row header and selecting Insert Row Above or Below from the context menu or the ribbon. Is there any way to do this for a table? The context menu doesn&#39;t appear and I can only delete rows via the...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'workspace editor'&s_tid=ans_lp_tag\" rel=\"nofollow\">workspace editor<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'insert rows'&s_tid=ans_lp_tag\" rel=\"nofollow\">insert rows<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>134<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/543809-how-to-import-data-in-matlab-when-we-are-using-matlab-in-online?s_tid=ans_recom_leaf\">how to import data in matlab when we are using matlab in online<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/18555704\">\n                                    <img alt=\"bhargavi veeraghattam\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/18555704?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/18555704\">bhargavi veeraghattam<\/a> on 07 June 2020\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">i want to import data from my desktop to matlab when i use matlab in online<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'importing excel data'&s_tid=ans_lp_tag\" rel=\"nofollow\">importing excel data<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>1<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>32<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>2<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2184122-how-to-enable-viewing-workspace-variables-when-hovering?s_tid=ans_recom_leaf\">How to enable viewing workspace variables when hovering<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/5207775\">\n                                    <img alt=\"David K\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/5207775?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/5207775\">David K<\/a> on 18 June 2026\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> This used to be a feature, but now I&#39;m not seeing it in 2025b. When I am stopped and debugging code, I can hover my cursor over a variable and it will display a pop-up with the value of the variable. It also used to do this when not in debug mode if the variable name matched one in the current ...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'workspace'&s_tid=ans_lp_tag\" rel=\"nofollow\">workspace<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'variables'&s_tid=ans_lp_tag\" rel=\"nofollow\">variables<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>1<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>33<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>2<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 1 Answer\"><span class=\"answers_meta_count\">2<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2184615-extract-individual-member-fields-from-h5-file?s_tid=ans_recom_leaf\">Extract individual member fields from h5 file<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/15150782\">\n                                    <img alt=\"Stephen Hall\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/15150782?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/15150782\">Stephen Hall<\/a> on 12 August 2026\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I have some large h5 files that I am unable to efficiently bring into MATLAB. Each group in these large files (50+GB for some) turns into a structure with dozens of fields, each of which is a vector with millions of individual values. This overwhelms the RAM on my computer, so I am looking for a wa...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'h5'&s_tid=ans_lp_tag\" rel=\"nofollow\">h5<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'hdf'&s_tid=ans_lp_tag\" rel=\"nofollow\">hdf<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'import'&s_tid=ans_lp_tag\" rel=\"nofollow\">import<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>124<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/411541-how-to-convert-m-file-to-txt-file-in-matlab?s_tid=ans_recom_leaf\">how to convert .m file to .txt file in matlab<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/13185775\">\n                                    <img alt=\"farha nazneen\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/13185775?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/13185775\">farha nazneen<\/a> on 22 July 2018\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello i generated a sine wave signal in matlab i got some values in workspace,i wanted to convert .m file to a .text file please do let me know how to proceed.The below is the attachment of my file. <\/p>\n                    \n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>32<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/705463-file-logging-basics-log-signal-data-to-file-logs-on-a-speedgoat-target-with-simulink-real-time-r202?s_tid=ans_recom_leaf\">File Logging Basics: Log signal data to File Logs on a Speedgoat target with Simulink Real-Time R2020b and later<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">\n                                    <img alt=\"MathWorks Support Team\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4622813?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">MathWorks Support Team<\/a> on 23 December 2020\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">The File Scope block and the &quot;SimulinkRealTime.fileScope&quot; object are no longer available in Simulink Real-Time (SLRT) R2020b and beyond. How can I perform signal data logging to the Speedgoat target computer file system in R2020b and beyond? kA03q00000114guCAA 000169843<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'slrt'&s_tid=ans_lp_tag\" rel=\"nofollow\">slrt<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'speedgoat'&s_tid=ans_lp_tag\" rel=\"nofollow\">speedgoat<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'logging'&s_tid=ans_lp_tag\" rel=\"nofollow\">logging<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>2<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>176<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2112956-unable-to-load-online-courses?s_tid=ans_recom_leaf\">Unable to load Online Courses<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/15469255\">\n                                    <img alt=\"David Cox\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/15469255?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/15469255\">David Cox<\/a> on 29 April 2024\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">I have got part way through the Self-Paced Online Courses but now it hangs trying to load. I&#39;m runnning a MacBook Pro M3 Pro<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'self-paced online courses'&s_tid=ans_lp_tag\" rel=\"nofollow\">self-paced online courses<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>28<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>1<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2174298-symbolic-math-toolbox-installation?s_tid=ans_recom_leaf\">Symbolic math toolbox installation.<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/35664244\">\n                                    <img alt=\"Manolis\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/35664244?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/35664244\">Manolis<\/a> on 20 February 2025\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">Good morning. Since yesterday I am trying to get and use Symbolic... I have paid already at the bank. The internet connection at home is perfect. So what&#39;s next ?<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'app installation'&s_tid=ans_lp_tag\" rel=\"nofollow\">app installation<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>32<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>3<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/406-how-do-i-skip-items-in-a-legend?s_tid=ans_recom_leaf\">How do I skip items in a legend?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/2295846\">\n                                    <img alt=\"henry wang\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/2295846?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/2295846\">henry wang<\/a> on 25 January 2011\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> How do I skip items in legend? Say I have 6 plots with 3 actual values and 3 interpolated curves. I only want to label the actual value curves so legend(&#39;first&#39;,&#39;&#39;,&#39;second&#39;,&#39;&#39;,&#39;third&#39;) doesn&#39;t really work because the interpolated curve still shows. kA03q0...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'legend'&s_tid=ans_lp_tag\" rel=\"nofollow\">legend<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>38<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>888<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>14<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 13 Answers\"><span class=\"answers_meta_count\">14<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/248667-how-much-does-a-matlab-compiler-cost?s_tid=ans_recom_leaf\">How much does a MatLab Compiler cost?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/6682104\">\n                                    <img alt=\"Kah Joon Yong\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/6682104?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/6682104\">Kah Joon Yong<\/a> on 14 October 2015\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">First how much does a compiler cost? Second can I use the compiler with my student version ML? Third why must a person request for a quote for the price of the compiler?<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'price'&s_tid=ans_lp_tag\" rel=\"nofollow\">price<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'student version'&s_tid=ans_lp_tag\" rel=\"nofollow\">student version<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>3<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>38<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>3<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/593848-micro-hydro-turbine-modeling-in-simulink?s_tid=ans_recom_leaf\">Micro-Hydro Turbine Modeling in Simulink<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/19020398\">\n                                    <img alt=\"Jannata Savira Transferano\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/19020398?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/19020398\">Jannata Savira Transferano<\/a> on 15 September 2020\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello, i&#39;m currently working on a research related to modeling and analysis Micro-Hydro Power Plant, does anyone have a simulink model for microhydro turbine? and do you know the name of this component in simulink, Thank you <\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'simulink'&s_tid=ans_lp_tag\" rel=\"nofollow\">simulink<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'model'&s_tid=ans_lp_tag\" rel=\"nofollow\">model<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>42<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>1<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 1 Answer\"><span class=\"answers_meta_count\">2<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/1897645-plot-clear-using-matlab-app-designer?s_tid=ans_recom_leaf\">Plot clear using MATLAB app designer.<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/21572131\">\n                                    <img alt=\"Othman Alkandri\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/21572131?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/21572131\">Othman Alkandri<\/a> on 20 January 2023\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello, I am trying to clear the UIAxies using a push button. Once the user clicks the button, it should remove the axis limitations and labels. I used the following command. function plotclearButtonPushed(app, event) cla(app.UIAxes) end The clear button erases the plot. However, it doesn&#39;t rese...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'appdesigner'&s_tid=ans_lp_tag\" rel=\"nofollow\">appdesigner<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'app designer'&s_tid=ans_lp_tag\" rel=\"nofollow\">app designer<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>29<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2178722-save-does-not-recognize-text-scalar?s_tid=ans_recom_leaf\">save does not recognize text scalar<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/33684073\">\n                                    <img alt=\"Richard\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/33684073?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/33684073\">Richard<\/a> on 24 July 2025\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> The following code snippet fails unexpectedly: clear; myFilename = &#39;SavedData&#39;; mustBeTextScalar(myFilename); % Throws exception if not true. x = 3; save(myFilename, x); The variable myFilename passes the mustBeTextScalar as expected. However, the save command fails with the message Error u...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'save'&s_tid=ans_lp_tag\" rel=\"nofollow\">save<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'text scalar'&s_tid=ans_lp_tag\" rel=\"nofollow\">text scalar<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'filename'&s_tid=ans_lp_tag\" rel=\"nofollow\">filename<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>32<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/350068-how-to-get-data-from-csv-file-to-table?s_tid=ans_recom_leaf\">How to get data from CSV file to Table<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">\n                                    <img alt=\"MathWorks Support Team\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4622813?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">MathWorks Support Team<\/a> on 12 July 2017\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">I have a CSV file and would like to use the data in MATLAB but I am unsure of how to do so. I would like to store the data in a table. How can I do this?\u00A0 kA00Z00000048QySAI 000089639<\/p>\n                    \n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>2<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>21<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2081-how-to-execute-two-matlab-scripts-simultaneously?s_tid=ans_recom_leaf\">How to execute two MATLAB scripts simultaneously<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/2719396\">\n                                    <img alt=\"Sabrina Wendt\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/2719396?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/2719396\">Sabrina Wendt<\/a> on 26 February 2011\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> How do I execute two MATLAB scripts simultaneously? The one script is recording an EEG measurement while the other script is generating a visual stimuli on the screen. I hope that it is possible! And if it is, it would be nice with a code example. The script for recording EEG is: fs= 256; measureme...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'simultaneously execution of multiple scripts'&s_tid=ans_lp_tag\" rel=\"nofollow\">simultaneously execution of multiple scripts<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'record and stimulate'&s_tid=ans_lp_tag\" rel=\"nofollow\">record and stimulate<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'eeg'&s_tid=ans_lp_tag\" rel=\"nofollow\">eeg<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>2<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>88<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>4<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 4 Answers\"><span class=\"answers_meta_count\">5<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/585347-plotting-a-3d-arrow-using-vectarrow?s_tid=ans_recom_leaf\">Plotting a 3D arrow using vectarrow<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/16769900\">\n                                    <img alt=\"Carolin Bock\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/16769900?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/16769900\">Carolin Bock<\/a> on 27 August 2020\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello, I&#39;m trying to plat a 3D arrow using the vectarrow function. I don&#39;t get any arrow messages but there is just now arrow in my plot. It would be great to get some tipps:) My code is the following: %50 J [X1,Y1] = meshgrid(1:0.025:1.7,0.05:0.05:0.25); p00_1 = 1.289; p10_1 = -0.3693; p01...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'3d arrow'&s_tid=ans_lp_tag\" rel=\"nofollow\">3d arrow<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'vectarrow'&s_tid=ans_lp_tag\" rel=\"nofollow\">vectarrow<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>1<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>33<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2101081-install-matlab-r2023b-on-mac?s_tid=ans_recom_leaf\">Install matlab R2023b on mac<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/30378561\">\n                                    <img alt=\"Parham Seraji\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/30378561?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/30378561\">Parham Seraji<\/a> on 31 March 2024\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> The final message of MATLAB installation is the message: Performing post-installation tasks. This may take a few minutes..., it has reached 100%, but it has not given the finish message for several hours ...<\/p>\n                        <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'installation'&s_tid=ans_lp_tag\" rel=\"nofollow\">installation<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'mac'&s_tid=ans_lp_tag\" rel=\"nofollow\">mac<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'matlab'&s_tid=ans_lp_tag\" rel=\"nofollow\">matlab<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>23<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 1 Answer\"><span class=\"answers_meta_count\">2<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/183629-how-can-i-turn-off-dbstop-if-error?s_tid=ans_recom_leaf\">How can I turn off dbstop if error<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/6103638\">\n                                    <img alt=\"Marina Frye\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/6103638?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/6103638\">Marina Frye<\/a> on 17 March 2015\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I use the &#39;dbstop if error&#39; to debug my programs which works perfectly fine for me. But during the writing of some code, it tends to stop in native functions that seemingly try to complete my tiping or give me hints while in the editor (for example functionhintsfunc.m or LinkProp.m) Due to ...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'debugger'&s_tid=ans_lp_tag\" rel=\"nofollow\">debugger<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'dbstop if error'&s_tid=ans_lp_tag\" rel=\"nofollow\">dbstop if error<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'close debugger'&s_tid=ans_lp_tag\" rel=\"nofollow\">close debugger<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>3<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>34<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2176614-why-is-the-matlab-r2024b-and-r2025a-prerelease-crashing-with-libmwagentspflegacyservicepublisher-dl?s_tid=ans_recom_leaf\">Why is the MATLAB R2024b and R2025a Prerelease crashing with &quot;libmwagentspflegacyservicepublisher.dll&quot; in the stack trace?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">\n                                    <img alt=\"MathWorks Support Team\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4622813?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">MathWorks Support Team<\/a> on 24 April 2025\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I am experiencing a sporadic crash in MATLAB. MATLAB crashes shortly after opening while idle, or when attempting to open Simulink, or attaching the Visual Studio Debugger. Below is the crash log that I receive: Crash Log: ----------------------------------------------------------------------------...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'matlabidle'&s_tid=ans_lp_tag\" rel=\"nofollow\">matlabidle<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'sporadiccrash'&s_tid=ans_lp_tag\" rel=\"nofollow\">sporadiccrash<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'opensimulink'&s_tid=ans_lp_tag\" rel=\"nofollow\">opensimulink<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>35<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/1766710-matlab-is-holding-on-to-a-lot-of-memory-is-this-expected?s_tid=ans_recom_leaf\">Matlab is holding on to a lot of memory. Is this expected?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/1155324\">\n                                    <img alt=\"Dmitry Kaplan\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/1155324?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/1155324\">Dmitry Kaplan<\/a> on 25 July 2022\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> When I first start matlab2022a, here&#39;s my RAM Matlab is using 4.5G. A lot, but not insane now-a-days. Here&#39;s what happens when I run it for a while -- about 8 hours straight. Notice that even after the &quot;clear all&quot;, matlab is still using &gt;20G. I think this is having a deliteriou...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'memory'&s_tid=ans_lp_tag\" rel=\"nofollow\">memory<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'memory leak'&s_tid=ans_lp_tag\" rel=\"nofollow\">memory leak<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'allocation'&s_tid=ans_lp_tag\" rel=\"nofollow\">allocation<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>42<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 1 Answer\"><span class=\"answers_meta_count\">2<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/370528-controlling-the-color-of-crosshair-raised-by-ginput?s_tid=ans_recom_leaf\">Controlling the color of crosshair raised by ginput<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/1376471\">\n                                    <img alt=\"Naum Derzhi\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/1376471?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/1376471\">Naum Derzhi<\/a> on 01 December 2017\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello, I need to use ginput. It &quot;raises raises crosshair in the axes&quot; - which is fine. Unfortunately, this crosshair is black, and in the axes where I need this function the background is, usually, black too, so the crosshair is very difficult to see. Changing background is not really an ...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'ginput'&s_tid=ans_lp_tag\" rel=\"nofollow\">ginput<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'crosshair'&s_tid=ans_lp_tag\" rel=\"nofollow\">crosshair<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'color'&s_tid=ans_lp_tag\" rel=\"nofollow\">color<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>27<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 1 Answer\"><span class=\"answers_meta_count\">2<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2046670-add-text-tile-to-tiled-layout?s_tid=ans_recom_leaf\">Add Text Tile to Tiled Layout<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/14896031\">\n                                    <img alt=\"Jim McIntyre\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/14896031?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/14896031\">Jim McIntyre<\/a> on 13 November 2023\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I&#39;m creating a tiled layout with several graphs that all relate to a single set of data. The data has say a dozen common properties, for example, the specimen name, the date, the size of the specimen, etc. In one of the tiles, I&#39;d really like to display these as a block of text intead of a ...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'tiled layout'&s_tid=ans_lp_tag\" rel=\"nofollow\">tiled layout<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'text box'&s_tid=ans_lp_tag\" rel=\"nofollow\">text box<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>34<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/1780220-how-to-plot-a-data-in-spherical-coordinates?s_tid=ans_recom_leaf\">How to plot a data in spherical coordinates?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/20805306\">\n                                    <img alt=\"Jagadeesh Korukonda\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/20805306?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/20805306\">Jagadeesh Korukonda<\/a> on 16 August 2022\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Let me explain, what I&#39;m actually solving. I&#39;m solving Diffusion-Reaction equation(2D) in spherical coordinates(axis-symmetric case). I&#39;m solving this equation numerically. So at the end I&#39;m getting , r, . So I want to plot this function in and plane instead of palne I&#39;m attachi...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'3d plots'&s_tid=ans_lp_tag\" rel=\"nofollow\">3d plots<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'plotting'&s_tid=ans_lp_tag\" rel=\"nofollow\">plotting<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>29<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n<\/div>"}],"type":"actions","responseTokens":{"profile.lastViewedEntity":"index","activity.name":"PERS_RECO_MLC-ANSWERS_WW_2026-06","profile.viewedAnswers":"[\"/matlabcentral/fileexchange/\",\"/videos.html\",\"/videos/search.html\",\"blogs index page\",\"/matlabcentral/cody\",\"/products/matlab-drive.html\",\"/support/bugreports/\",\"/matlabcentral/answers/index/\",\"homepage\",\"/search/user-center\"]","profile.ip_address":"99.61.2.250","profile.visitNumber_1":"true","geo.city":"smyrna","activity.id":"667293","profile.Three_impression_Login":"3","experience.name":"Experience B","geo.country":"united states","offer.name":"Offer 1780998743827","activity.decisioningMethod":"server-side","profile.twogroups":"GroupB"},"sourceType":"target"}]}}}