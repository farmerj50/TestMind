  <script>
    var addGroupCards = $.addGroupCardComponents();

    let trendingGroupCardDivId = 'groupCards-trendingGroups';
    let trendingGroups = [{"id":52300,"name":"High School Challenge","description":"This group contains problems for high school students so that they can practice their programming skills in MATLAB.","problemsCount":50,"solvedCount":0,"percentageComplete":0.0,"url":"/matlabcentral/cody/matlabcentral/cody/groups/52300","image":"/responsive_image/200/150/0/0/0/cache/matlabcentral/cody/group/52300/show_image/1666827973.jpg","recentSolversCount":188,"difficultyRating":"easy-medium","difficultyValue":1.2759843},{"id":282,"name":"Basics on π","description":"π is also called as Archimedes' constant. The historically first exact formula for π, based on infinite series, was not available until a millennium later, when in the 14th century the Madhava-Leibniz series was discovered in Indian mathematics.","problemsCount":10,"solvedCount":0,"percentageComplete":0.0,"url":"/matlabcentral/cody/matlabcentral/cody/groups/282","image":"/responsive_image/200/150/0/0/0/cache/matlabcentral/cody/group/282/show_image/1557346815.jpg","recentSolversCount":678,"difficultyRating":"easy-medium","difficultyValue":1.3455411},{"id":78,"name":"Introduction to MATLAB","description":"New to Cody? Start solving simple MATLAB problems that will test your basic MATLAB skills.\nIf you are new to MATLAB, you can start with MATLAB Onramp, which is a two-hour introductory tutorial on commonly used MATLAB features and workflows.","problemsCount":23,"solvedCount":0,"percentageComplete":0.0,"url":"/matlabcentral/cody/matlabcentral/cody/groups/78","image":"/responsive_image/200/150/0/0/0/cache/matlabcentral/cody/group/78/show_image/1721673513.jpg","recentSolversCount":10110,"difficultyRating":"easy-medium","difficultyValue":1.4708002},{"id":1110,"name":"MATLAB Onramp Practice","description":"Practice your introductory MATLAB skills with these simple coding problems.\nThese problems are based on the skills you learn in MATLAB Onramp, a free, two-hour tutorial on introductory MATLAB features and workflows.","problemsCount":15,"solvedCount":0,"percentageComplete":0.0,"url":"/matlabcentral/cody/matlabcentral/cody/groups/1110","image":"/responsive_image/200/150/0/0/0/cache/matlabcentral/cody/group/1110/show_image/1611961592.jpg","recentSolversCount":5259,"difficultyRating":"easy-medium","difficultyValue":1.678584}];
    addGroupCards.renderGroupCards(trendingGroupCardDivId, trendingGroups);

    let newGroupCardDivId = 'groupCards-newGroups';
    let newGroups = [{"id":98321,"name":"Systems Engineering","description":"Explore a set of interesting and practical MATLAB problems inspired by systems engineering. From requirement engineering to systems architetcure and systems verification, these challenges help you build system-level thinking.\nDesigned to be engaging, hands-on, and progressive, this problem group is perfect for learners, whether you're a student or an engineer, these interesting problems will sharpen your modelling, analytical, and computational skills.","problemsCount":12,"solvedCount":0,"percentageComplete":0.0,"url":"/matlabcentral/cody/matlabcentral/cody/groups/98321","image":"/responsive_image/200/150/0/0/0/cache/matlabcentral/cody/group/98321/show_image/1788196201.jpg","recentSolversCount":10,"difficultyRating":"easy","difficultyValue":1.0},{"id":98300,"name":"Basic Geometry","description":"Simple Geometry. Nothing else.","problemsCount":12,"solvedCount":0,"percentageComplete":0.0,"url":"/matlabcentral/cody/matlabcentral/cody/groups/98300","image":"/responsive_image/200/150/0/0/0/cache/matlabcentral/cody/group/98300/show_image/1787585200.jpg","recentSolversCount":6,"difficultyRating":"easy-medium","difficultyValue":1.4}];
