{"status":200,"requestId":"7d836856c38448909e843f09ccb0cacf","client":"themathworksinc","id":{"tntId":"7fba70139bf24e4b931a545c707ab40c.34_0","marketingCloudVisitorId":"74536194091804629725748413948792422794"},"edgeHost":"mboxedge34.tt.omtrdc.net","prefetch":{"metrics":[{"type":"click","selector":".relatedvideos","eventToken":"6ty5hBqgJ4xwSOovHEJalqfTGr5TkOwetX776XnugEFkOon0R+JCZZFUHuTOR2fc"},{"type":"click","selector":"#tab_recommendations > DIV:nth-of-type(1)","eventToken":"cZGViIvgeI1osEsCvzDO4qfTGr5TkOwetX776XnugEFkOon0R+JCZZFUHuTOR2fc"}]},"telemetryServerToken":"p4YQxyYgYUTaezwmtUViaJ9uGl6QykMVdM+O428ZTt8=","execute":{"pageLoad":{"options":[{"content":[{"type":"customCode","selector":"HEAD","cssSelector":"","content":"<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  if (any_recommended_feed_items()) {\n    remove_recommended_feed_hidden_styles();\n  }\n  // now knowing whether the recommended feed items loaded properly or not\n  // select the appropriate feed, overriding the prior selection from the index page\n  // set cookie value to default only if invalid or nonexistant \n  var cookie_val = get_default_feed_cookie_pref();   \n  if (!is_feed_cookie_value_valid(cookie_val)) {\n    set_default_feed_cookie_pref();\n    cookie_val = get_feed_cookie_pref();\n  }\n  // if the recommended feed items did not load properly \n  // or if the activity feed does not exist (when one is logged out)\n  // then select the the appropriate feed but do not set the cookie value \n  var activity_tab = document.getElementById(\"tab_activities\");  \n  if ((cookie_val === \"Recommended\") || ((cookie_val === \"Activities\") && (activity_tab == undefined))) {\n    if (any_recommended_feed_items()) {    \n      cookie_val = \"Recommended\"\n    } else {\n      cookie_val = \"Trending\"\n    }\n  }\n  select_feed(cookie_val.toLowerCase(), true);\n});\n</script>"}],"type":"actions","responseTokens":{"profile.lastViewedEntity":"index","activity.name":"PERS_RECO_ML