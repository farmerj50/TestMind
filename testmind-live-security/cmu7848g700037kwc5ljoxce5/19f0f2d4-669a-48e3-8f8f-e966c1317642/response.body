":"667293","profile.Three_impression_Login":"3","experience.name":"Experience B","geo.country":"united states","offer.name":"Default Content","activity.decisioningMethod":"server-side","profile.twogroups":"GroupB"},"sourceType":"target"},{"content":[{"type":"setHtml","selector":"#recommended_feed_items > DIV:nth-of-type(1)","cssSelector":"#recommended_feed_items > DIV:nth-of-type(1)","content":"<div  id=\"recommendation_feed_items\" class=\"feed_items col-xs-12 add_margin_20_sm\">\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2181544-save-data-from-simulink-scope?s_tid=ans_recom_leaf\">Save data from Simulink Scope<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/25661341\">\n                                    <img alt=\"Jack Daniels\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/25661341?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/25661341\">Jack Daniels<\/a> on 28-Nov-25\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I have checked &quot;Log data to workspace&quot; in the Simulink Scope under the Logging pane, but after running the simulation, no data are saved to the workspace. Is there any additional setting required to ensure that the data are stored correctly? Thank you <\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'data workspace saving from simulink scope'&s_tid=ans_lp_tag\" rel=\"nofollow\">data workspace saving from simulink scope<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>1<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>19<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>2<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/92975-what-are-redundant-servers-how-do-i-generate-a-license-file-for-one-and-how-do-i-set-it-up?s_tid=ans_recom_leaf\">What are redundant servers, how do I generate a license file for one, and how do I set it up?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">\n                                    <img alt=\"MathWorks Support Team\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4622813?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">MathWorks Support Team<\/a> on 06 July 2009\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I would like to know what redundant servers are, and how to generate and install a redundant server license file for MATLAB and associated products. kA0i00000007krqCAA 000003907<\/p>\n                    \n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>54<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2112956-unable-to-load-online-courses?s_tid=ans_recom_leaf\">Unable to load Online Courses<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/15469255\">\n                                    <img alt=\"David Cox\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/15469255?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/15469255\">David Cox<\/a> on 29 April 2024\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">I have got part way through the Self-Paced Online Courses but now it hangs trying to load. I&#39;m runnning a MacBook Pro M3 Pro<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'self-paced online courses'&s_tid=ans_lp_tag\" rel=\"nofollow\">self-paced online courses<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>28<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>1<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2167128-how-to-speed-up-simscape-electrical-simulation?s_tid=ans_recom_leaf\">How to speed up simscape electrical simulation?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/30556740\">\n                                    <img alt=\"Hassan Ali\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/30556740?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/30556740\">Hassan Ali<\/a> on 19 November 2024\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Greetings everyone, I have been trying to find the way to simulate the simscape electrical model much faster. I have designed a drivetrain model using simscape electrical, in which the 3-phase inverter contains 6 N-channel MOSFETs which I have parameterized using silicon MOSFETs datasheet. The PMSM...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'ev'&s_tid=ans_lp_tag\" rel=\"nofollow\">ev<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'power_electronics_control'&s_tid=ans_lp_tag\" rel=\"nofollow\">power_electronics_control<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'simscape'&s_tid=ans_lp_tag\" rel=\"nofollow\">simscape<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>44<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 1 Answer\"><span class=\"answers_meta_count\">2<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/543809-how-to-import-data-in-matlab-when-we-are-using-matlab-in-online?s_tid=ans_recom_leaf\">how to import data in matlab when we are using matlab in online<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/18555704\">\n                                    <img alt=\"bhargavi veeraghattam\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/18555704?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/18555704\">bhargavi veeraghattam<\/a> on 07 June 2020\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">i want to import data from my desktop to matlab when i use matlab in online<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'importing excel data'&s_tid=ans_lp_tag\" rel=\"nofollow\">importing excel data<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>1<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>32<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>2<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/1940819-how-many-instances-of-matlab-can-i-run-simultaneously-on-windows-linux-platform?s_tid=ans_recom_leaf\">How many instances of MATLAB can I run simultaneously on Windows\/Linux platform ?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/27882294\">\n                                    <img alt=\"Montina\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/27882294?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/27882294\">Montina<\/a> on 04 April 2023\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I want to know how many instances of MATLAB can be opened on Windows or Linux platform. And how much of RAM is needed for single instance of MATLAB in Windows or Linux platform. I have gone through the below link. So will the usage of RAM, be same or will change? https:\/\/in.mathworks.com\/matlabcent...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'matlab'&s_tid=ans_lp_tag\" rel=\"nofollow\">matlab<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>21<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 1 Answer\"><span class=\"answers_meta_count\">2<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/146782-solve-state-space-equation-by-ode45?s_tid=ans_recom_leaf\">Solve state space equation by ODE45<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4119052\">\n                                    <img alt=\"Babak\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4119052?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4119052\">Babak<\/a> on 08 August 2014\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello everybody. I am new to state space representation. please help me to solve this question. I have state space equation for IM motor like this: xdot=A.x+B.u --&gt; and their dimensions are : [50,1]=[50,50]*[50,1]+[50,50]*[50,1] I have calculated A &amp; B and I need to get xdot. (there are no C...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'ode45'&s_tid=ans_lp_tag\" rel=\"nofollow\">ode45<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'state space'&s_tid=ans_lp_tag\" rel=\"nofollow\">state space<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'differential equations'&s_tid=ans_lp_tag\" rel=\"nofollow\">differential equations<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>1<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>93<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 5 Answers\"><span class=\"answers_meta_count\">6<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/847010-why-do-i-receive-an-error-when-downloading-installation-files-with-the-r2021b-mathworks-installer-an?s_tid=ans_recom_leaf\">Why do I receive an error when downloading installation files with the R2021b MathWorks Installer and newer?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">\n                                    <img alt=\"MathWorks Support Team\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4622813?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">MathWorks Support Team<\/a> on 03 June 2021\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">Why do I receive the following error when downloading installation files using the &quot;I want to download without installing&quot; option in the R2021b and newer MathWorks Installer? Download Error: An error has occurred when trying to download the installer kA03q0000015Kv8CAE 000180438<\/p>\n                    \n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>12<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/101155-how-do-i-obtain-the-prerelease-for-a-new-matlab-version?s_tid=ans_recom_leaf\">How do I obtain the Prerelease for a new MATLAB version?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">\n                                    <img alt=\"MathWorks Support Team\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4622813?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">MathWorks Support Team<\/a> on 14 June 2012\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I have received a notification that a new MATLAB Prerelease is available, and I would like to install the Prerelease. How do I do so? kA0i00000007kxxCAA 000004283<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'prerelease'&s_tid=ans_lp_tag\" rel=\"nofollow\">prerelease<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>3<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>45<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2184689-r2026a-home-insert-row-into-table-using-the-workspace-editor-arbitrary-position?s_tid=ans_recom_leaf\">R2026a Home: Insert row into table using the Workspace Editor (arbitrary position)<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/23654092\">\n                                    <img alt=\"Ravi Narasimhan\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/23654092?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/23654092\">Ravi Narasimhan<\/a> on 19 August 2026\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Using the workspace editor, I can insert a row at an arbitrary position in an array by clicking the row header and selecting Insert Row Above or Below from the context menu or the ribbon. Is there any way to do this for a table? The context menu doesn&#39;t appear and I can only delete rows via the...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'workspace editor'&s_tid=ans_lp_tag\" rel=\"nofollow\">workspace editor<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'insert rows'&s_tid=ans_lp_tag\" rel=\"nofollow\">insert rows<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>134<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/1899890-why-do-i-get-an-unable-to-continue-error-201-when-updating-matlab?s_tid=ans_recom_leaf\">Why do I get an &#39;Unable to continue Error 201&quot; when updating MATLAB?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">\n                                    <img alt=\"MathWorks Support Team\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4622813?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">MathWorks Support Team<\/a> on 24 January 2023\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> When updating MATLAB, I receive an error message saying &quot;Unable to continue&quot;. What causes this, and how can I resolve it?\u00A0 kA03q000000t1v0CAA 000335773<\/p>\n                    \n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>31<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/111358-input-function-to-enter-array-elements?s_tid=ans_recom_leaf\">input function to enter array elements<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/3265467\">\n                                    <img alt=\"Abdulaziz\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/3265467?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/3265467\">Abdulaziz<\/a> on 04 January 2014\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">Hi guysy, I have different cases I want to calculate and plot. I am wondering if there is anyway to use input function to prompt user to choose the cases through typing the cases numbers to array with flexible length for example Cases=inpute [ 1 3 5] or Cases=inpute [ 1 3 5 9] I appreciate your help...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'input function'&s_tid=ans_lp_tag\" rel=\"nofollow\">input function<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'enter array elements'&s_tid=ans_lp_tag\" rel=\"nofollow\">enter array elements<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>31<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 1 Answer\"><span class=\"answers_meta_count\">2<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/457361-how-can-i-install-mosek-in-matlab-for-free?s_tid=ans_recom_leaf\">How can I install mosek in matlab for free?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/15283432\">\n                                    <img alt=\"Karry Ma\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/15283432?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/15283432\">Karry Ma<\/a> on 19 April 2019\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">How can I install mosek in matlab for free?<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'installation'&s_tid=ans_lp_tag\" rel=\"nofollow\">installation<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>35<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>6<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 5 Answers\"><span class=\"answers_meta_count\">6<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2181110-how-to-run-spsconversionassistant?s_tid=ans_recom_leaf\">How to run spsConversionAssistant?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/20004126\">\n                                    <img alt=\"JUAN ANTONIO CABEZA L\u00D3PEZ DE TAMAYO\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/20004126?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/20004126\">JUAN ANTONIO CABEZA L\u00D3PEZ DE TAMAYO<\/a> on 07 November 2025\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">I refer to a grid-forming BESS simulink model that I have developed with R2024b. When I open it with R2025b the following error message is displayed: &quot;This model uses Simscape Electrical Specialized Power Systems blocks which will be removed in a future release. Use Simscape Electrical blocks ...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'spsconversionassistant'&s_tid=ans_lp_tag\" rel=\"nofollow\">spsconversionassistant<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>72<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/96131-is-there-a-format-in-matlab-to-display-numbers-such-that-commas-are-automatically-inserted-into-the?s_tid=ans_recom_leaf\">Is there a format in MATLAB to display numbers such that commas are automatically inserted into the display?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">\n                                    <img alt=\"MathWorks Support Team\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4622813?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">MathWorks Support Team<\/a> on 12 March 2012\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> I would like to display large numbers with commas separating the digits for readability purposes. For example, I would like MATLAB to display one billion as 1,000,000,000 rather than 1000000000. How can I do this? kA0i00000007rU7CAI 000029334<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'comma'&s_tid=ans_lp_tag\" rel=\"nofollow\">comma<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'digits'&s_tid=ans_lp_tag\" rel=\"nofollow\">digits<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'decimalformat'&s_tid=ans_lp_tag\" rel=\"nofollow\">decimalformat<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>2<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>38<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 2 Answers\"><span class=\"answers_meta_count\">3<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2122296-making-use-of-figure-numbers-is-discouraged-what-are-your-workarounds?s_tid=ans_recom_leaf\">Making use of figure numbers is discouraged \u2013 what are your workarounds?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/872224\">\n                                    <img alt=\"Andres\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/872224?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/872224\">Andres<\/a> on 24 May 2024\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Quite a common task, I assume: based on a simulation or measurement run I generate a set of figures to display the results. I find it convenient to group the figure numbers of a single run in a certain number range, say 1XXX or 2XXX. In this way I can compare specific results of different runs by q...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'figure'&s_tid=ans_lp_tag\" rel=\"nofollow\">figure<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'figure number'&s_tid=ans_lp_tag\" rel=\"nofollow\">figure number<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'figure handle'&s_tid=ans_lp_tag\" rel=\"nofollow\">figure handle<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>34<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>1<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 2 Answers\"><span class=\"answers_meta_count\">3<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/263788-how-to-detect-if-a-figure-exist?s_tid=ans_recom_leaf\">How to detect if a figure exist?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4297175\">\n                                    <img alt=\"John\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4297175?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4297175\">John<\/a> on 14 January 2016\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> To save the figure if one exists with: saveas(gcf,figname); the problem is that if no figure exists, it&#39;ll create a figure. How to detect if a figure exist before using above saveas command to avoid the creation of an empty figure? Thanks.<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'saveas'&s_tid=ans_lp_tag\" rel=\"nofollow\">saveas<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'figure'&s_tid=ans_lp_tag\" rel=\"nofollow\">figure<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>25<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer, 1 Answer\"><span class=\"answers_meta_count\">2<\/span><span class=\"answers_meta_label\">answers<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/455753-after-using-fft-getting-nan-why?s_tid=ans_recom_leaf\">After using &quot;FFT&quot; getting NAN. Why?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/8962439\">\n                                    <img alt=\"Danish Ahmad\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/8962439?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/8962439\">Danish Ahmad<\/a> on 11 April 2019\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> clc close all clear all %% data = xlsread(&#39;freq15.xlsx&#39;,&#39;Group Name #2&#39;); v= data(:,1); plot (v); title(&#39;Voltage signal with noise&#39;) xlabel(&#39;Samples&#39;) ylabel(&#39;Amplitudes&#39;) %% %plot magnitude specturm of a signal clc format long X_mag=abs((fft(v))) figure(1) p...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'fft'&s_tid=ans_lp_tag\" rel=\"nofollow\">fft<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'nan'&s_tid=ans_lp_tag\" rel=\"nofollow\">nan<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>27<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>2<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/231482-comment-my-function-in-order-to-get-a-decent-title-in-the-documentation?s_tid=ans_recom_leaf\">Comment my function in order to get a decent title in the documentation<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/3348936\">\n                                    <img alt=\"Vincent\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/3348936?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/3348936\">Vincent<\/a> on 28 July 2015\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello everyone, I am in the process of figuring out how to comment adequately my function so that its html published version is easy to read for everyone. By that I mean that I would appreciate if it had a nice bold orange title, with a description underneath it and then the table of content for ea...<\/p>\n                        <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'documentation'&s_tid=ans_lp_tag\" rel=\"nofollow\">documentation<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'function'&s_tid=ans_lp_tag\" rel=\"nofollow\">function<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'title'&s_tid=ans_lp_tag\" rel=\"nofollow\">title<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>39<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2112996-how-can-i-get-debug-information-for-polyspace-access-running-in-kubernetes?s_tid=ans_recom_leaf\">How can I get debug information for Polyspace Access running in Kubernetes?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">\n                                    <img alt=\"MathWorks Support Team\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4622813?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">MathWorks Support Team<\/a> on 29 April 2024\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> When experiencing an issue with Polyspace Access installed in a Kubernetes cluster, how do I generate logs or reports that I can send to MathWorks Support to help diagnose the issue? kA03q000000YkbbCAC 000506818<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'polyspace_access'&s_tid=ans_lp_tag\" rel=\"nofollow\">polyspace_access<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'kubernetes'&s_tid=ans_lp_tag\" rel=\"nofollow\">kubernetes<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>1<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>70<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/507962-why-do-i-get-the-error-unrecognized-function-or-variable-ctfroot-when-running-matlabwebappserv?s_tid=ans_recom_leaf\">Why do I get the error &quot;Unrecognized function or variable &#39;ctfroot&#39;&quot; when running &quot;MATLABWebAppServer.exe&quot;?<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">\n                                    <img alt=\"MathWorks Support Team\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/4622813?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/4622813\">MathWorks Support Team<\/a> on 27 February 2020\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">Why do I get the error &quot;Unrecognized function or variable &#39;ctfroot&#39;&quot; when running the Development version of MATLAB Web App Server - &quot;MATLABWebAppServer.exe&quot;? Here is a screenshot of the exact error: kA00Z000000skZzSAI 000123446<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'matlabwebappserver'&s_tid=ans_lp_tag\" rel=\"nofollow\">matlabwebappserver<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'ctfroot'&s_tid=ans_lp_tag\" rel=\"nofollow\">ctfroot<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'unrecognized'&s_tid=ans_lp_tag\" rel=\"nofollow\">unrecognized<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>34<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/458098-difference-between-valuechangedfcn-valuechangingfcn?s_tid=ans_recom_leaf\">Difference Between ValueChangedFcn &amp; ValueChangingFcn<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/3593278\">\n                                    <img alt=\"John hope\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/3593278?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/3593278\">John hope<\/a> on 24 April 2019\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\">Hi all I have a GUI which includes:- Edit Field Text Edit Field Text Text Area For Edit Field Text &amp; Edit Field Text i have the option to create two callbacks which are:- 1) Add ValueChangedFcn 2) Add ValueChangingFcn Can anyone explain what the difference is between these two? Also on the Text...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'valuechangingfcn'&s_tid=ans_lp_tag\" rel=\"nofollow\">valuechangingfcn<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'valuechangedfcn'&s_tid=ans_lp_tag\" rel=\"nofollow\">valuechangedfcn<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>26<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>1<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/82399-find-values-and-replace-them-with-nan-add-total-number-of-nan-values?s_tid=ans_recom_leaf\">Find values and replace them with NaN, add total number of NaN values.<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/3675563\">\n                                    <img alt=\"Theodore\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/3675563?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/3675563\">Theodore<\/a> on 17 July 2013\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello! So within 3 different columns of data which I have defined as: mintemp = b(:,4) maxtemp = b(:,5) avgtemp = b(:,6) I want to take each individual row (1 column at a time) and find the -9999 values which are NaN values and replace them with &#39;NaN&#39; so that when I calculate the average of...<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'find value'&s_tid=ans_lp_tag\" rel=\"nofollow\">find value<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'replace value'&s_tid=ans_lp_tag\" rel=\"nofollow\">replace value<\/a><span class=\"separator\"><\/span><a href=\"\/matlabcentral\/answers\/?term=tag:'add total number of values'&s_tid=ans_lp_tag\" rel=\"nofollow\">add total number of values<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>26<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/411541-how-to-convert-m-file-to-txt-file-in-matlab?s_tid=ans_recom_leaf\">how to convert .m file to .txt file in matlab<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/13185775\">\n                                    <img alt=\"farha nazneen\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/13185775?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/13185775\">farha nazneen<\/a> on 22 July 2018\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> Hello i generated a sine wave signal in matlab i got some values in workspace,i wanted to convert .m file to a .text file please do let me know how to proceed.The below is the attachment of my file. <\/p>\n                    \n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>32<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>0<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n    <div class=\"panel panel-default lp-answers-card search_result add_padding_0\">\n        <div class=\"panel-body w-100\">\n            <p class=\"h3 question_title add_margin_12\"><a class=\"card-title\" href=\"\/matlabcentral\/answers\/2171189-changing-matlab-online-version-to-older-one?s_tid=ans_recom_leaf\">Changing Matlab online version to older one<\/a><\/p>\n            <div class=\"d-flex flex-row\">\n                <div class=\"search_result_content\">\n                    <div class=\"post_meta search_result_meta\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0\" aria-hidden=\"true\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/7086203\">\n                                    <img alt=\"rabih Al Ahmadieh\" class=\"rounded-circle community_profile_image\" src=\"\/responsive_image\/75\/75\/0\/0\/0\/profile\/7086203?s_tid=ans_recom_user\" width=\"24\" onerror=\"img_not_found(this, '\/responsive_image\/100\/0\/0\/0\/0\/cache\/matlabcentral\/profiles\/profilepic_default.gif');\">\n                                <\/a>\n                            <\/div>\n                            <div class=\"flex-grow-1 ms-2\">\n                                <a class=\"author_inline\" data-locale-id=\"en\" href=\"\/matlabcentral\/profile\/authors\/7086203\">rabih Al Ahmadieh<\/a> on 05 December 2024\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                    <p class=\"post_body text-wrap d-none d-md-block search_result_desc\"> HI, How can I change the Matlab online version to an older version. I do not want to use 2024b or 2024b just any older version will be good. Thank you<\/p>\n                    <div class=\"search_result_meta answer-tag-list tags_ans_lp\"><strong>Tags<\/strong>:<a href=\"\/matlabcentral\/answers\/?term=tag:'version change'&s_tid=ans_lp_tag\" rel=\"nofollow\">version change<\/a><\/div>\n                    <div class=\"search_result_meta feed_stats\"><ul class=\"list-inline -has_list_separators\"><li class=\"list-inline-item\"><span class=\"icon-like feed_votes\" aria-label=\"votes\"><\/span>0<\/li><li class=\"list-inline-item\"><span class=\"icon-watch feed_views\" aria-label=\"views\"><\/span>24<\/li><li class=\"list-inline-item\"><span class=\"icon-feedback feed_comments\" aria-label=\"comments\"><\/span>4<\/li><\/ul><\/div>\n                <\/div>\n                <div class=\"lp-answers-card_sidebar\"><div class=\"search_result_supplemental_content justify-content-center align-items-center d-flex flex-column\"><div class=\"answers_meta -is_accepted\" data-accepted-label=\"Accepted Answer\" data-bs-toggle=\"tooltip\" data-bs-title=\"1 Accepted Answer\"><span class=\"answers_meta_count\">1<\/span><span class=\"answers_meta_label\">answer<\/span><\/div><\/div><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n<\/div>"}],"type":"actions","responseTokens":{"profile.lastViewedEntity":"index","activity.name":"PERS_RECO_MLC-ANSWERS_WW_2026-06","profile.viewedAnswers":"[\"/matlabcentral/answers/index\",\"/matlabcentral/fileexchange\",\"/matlabcentral/fileexchange/\",\"/videos.html\",\"/videos/search.html\",\"blogs index page\",\"/matlabcentral/cody\",\"/products/matlab-drive.html\",\"/support/bugreports/\",\"/matlabcentral/answers/index/\"]","profile.ip_address":"99.61.2.250","profile.visitNumber_1":"true","geo.city":"smyrna","activity.id":"667293","profile.Three_impression_Login":"3","experience.name":"Experience B","geo.country":"united states","offer.name":"Offer 1780998743827","activity.decisioningMethod":"server-side","profile.twogroups":"GroupB"},"sourceType":"target"}],"metrics":[{"type":"click","selector":".relatedvideos","eventToken":"6ty5hBqgJ4xwSOovHEJalqfTGr5TkOwetX776XnugEFkOon0R+JCZZFUHuTOR2fc"},{"type":"click","selector":"#tab_recommendations > DIV:nth-of-type(1)","eventToken":"cZGViIvgeI1osEsCvzDO4qfTGr5TkOwetX776XnugEFkOon0R+JCZZFUHuTOR2fc"}]}}}