<!-- theme initialization: apply dark/light class based on OS preference -->
<script>
  (function() {
    var root = document.documentElement;
    var body = document.body;
    var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    var cls = dark ? 'mw-theme-dark' : 'mw-theme-light';
    root.classList.add(cls);
    body.classList.add(cls);
    body.style.colorScheme = dark ? 'dark' : 'light';
    if (window.matchMedia) {
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
        root.classList.remove('mw-theme-dark', 'mw-theme-light');
        body.classList.remove('mw-theme-dark', 'mw-theme-light');
        if (e.matches) {
          root.classList.add('mw-theme-dark');
          body.classList.add('mw-theme-dark');
          body.style.colorScheme = 'dark';
        } else {
          root.classList.add('mw-theme-light');
          body.classList.add('mw-theme-light');
          body.style.colorScheme = 'light';
        }
      });
    }
  })();
</script>

<!-- translation script -->
<script>
  var lang = document.documentElement.lang;
  if (lang) {
    window.$mw = window.$mw || {};
    window.$mw.i18n = window.$mw.i18n || {};
    var langs = [lang.toLowerCase()];
    if (lang.toLowerCase() === 'zh') { langs.push('zh-cn'); }
    window.$mw.i18n.languages = window.$mw.i18n.languages || langs;
  }
</script>

<!-- typeahead script -->
<script>
  (function () {
    function getLocale() {
      const htmlLang = (document.documentElement.getAttribute('lang') || '').trim();
      return htmlLang || 'en';
    }
    document.addEventListener('DOMContentLoaded', function () {
      const possibleSelectors = ['#query'];

      const env = ''.replace(/^-/, '') || 'prod';
      const locale = getLocale();

      possibleSelectors.forEach(function (selector) {
        const inputElement = document.querySelector(selector);
        if (inputElement) {
          const customElement = document.createElement('userarea-typeahead');
          customElement.setAttribute('input-selector', selector);
          customElement.setAttribute('collection', 'usercenter');
          customElement.setAttribute('app-label', '');
          customElement.setAttribute('env', env);
          customElement.setAttribute('site-language', locale);
          customElement.setAttribute('blank-state', 'true');
          document.body.appendChild(customElement);
        }
      });
    });
  })();
</script>


