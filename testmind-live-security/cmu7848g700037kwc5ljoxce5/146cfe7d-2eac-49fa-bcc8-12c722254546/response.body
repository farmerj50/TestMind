  <script src="/matlabcentral/jscript/userarea-typeahead-v1.js"></script>
  <script type="text/javascript">
	document.addEventListener("DOMContentLoaded", function () {
		const typeaheadConfigs = [
		{
			selector: '#query',
			blankState: 'true'
		},
		{
			selector: '#search_scope_contributors_name',
			blankState: 'false',
			addProfile: 'false'
		}];

		typeaheadConfigs.forEach(config => {
		const inputElement = document.querySelector(config.selector);
		if (inputElement) {
			const typeaheadElement = document.createElement('userarea-typeahead');
			typeaheadElement.setAttribute('input-selector', config.selector);
			typeaheadElement.setAttribute('collection', 'community_profiles');
			typeaheadElement.setAttribute('app-label', 'Community Profiles');
			typeaheadElement.setAttribute('env', 'prod');
			typeaheadElement.setAttribute('site-language', document.documentElement.lang);
			typeaheadElement.setAttribute('blank-state', config.blankState);
			if (config.addProfile) {
				typeaheadElement.setAttribute('add-profile', config.addProfile);
			}
			document.body.appendChild(typeaheadElement);
		}
		});
	});
  </script>





