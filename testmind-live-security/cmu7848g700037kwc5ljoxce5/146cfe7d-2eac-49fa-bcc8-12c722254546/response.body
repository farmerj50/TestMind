			<script src="/matlabcentral/profile/assets/jquery-ui.custom-d366b228a139a13c0a58edd06203f368001f0befcd88d76f05603de042a323e8.js"></script>



  <script src="/matlabcentral/profile/assets/jquery.cookie.min-af1c5d1d04896d41311b14f087a5b531403d11050adc042247164794df1ff3dd.js"></script>
  <script src="/includes_content/responsive/scripts/lightslider.js"></script>
  <link rel="stylesheet" href="/matlabcentral/profile/assets/home-83d135da0a7a8bb2f63a9b3d0a2fbfd03611873c5d75271d420bb34af10c91f0.css" />
  <script src="/matlabcentral/profile/assets/home-d1c845d8d86816ea0c34457563687c63f6bf20141258619d0cfca43a73dd108e.js"></script>
  <script src="/matlabcentral/profile/assets/dropdownCheckboxes.min-b5be714a0386a61329db15bc480a3ab39b5c339859ce7f44c15d5cf4e54512bc.js"></script>
  <script type="text/javascript">
    $(document).on('click', '.cq-dropdown .dropdown-menu', function (e) {
      e.stopPropagation();
    });

    $(function () {
      $('.cq-dropdown').dropdownCheckboxes();
    });

    $(document).ready(function () {
      $("head").append('<meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">');

      var app_choices = $.cookie('mathworks_cmty_landing_app_selector');

      $('.borderless_tab_controls a').click(function (e) {
          $(this).tab('show');
      });

      $(".recommendation-tab, .activity-tab").click(function () {
        $("#dropdown1").addClass("disabled");
        $(".dropdown1_label").text("All Community");
      });

      $(".newest-tab, .trending-tab").click(function () {
        $("#dropdown1").removeClass("disabled");
        if (app_choices !== undefined) {
          if (app_choices == "all" || app_choices == "null" ) {
            $(".dropdown1_label").text("All Community");
          } else {
            $.each(app_choices.split(","), function (i, val) {
              $("input[value='" + val + "']").prop('checked', true);
            });
            var selected = [];
            $('.dropdown-menu input:checked').each(function() {
              selected.push($(this).attr('name'));
            });
            $(".dropdown1_label").text(selected);
          }
        }
      });

      $("#save-app").click(function () {
        var val = [];
        $(':checkbox:checked').each(function (i) {
          val[i] = $(this).val();
        });
        if (val.length == 0) {
          $.cookie('mathworks_cmty_landing_app_selector', 'all', {path: '/'});
        } else {
          $.cookie('mathworks_cmty_landing_app_selector', val, {path: '/'});
        }
        location.reload();
      });

      $("#clear-app").click(function () {
        $.cookie('mathworks_cmty_landing_app_selector', 'all', {path: '/'});
        location.reload();

      });

      if (app_choices !== undefined) {
        if (app_choices == "all" || app_choices == "null" ) {
          $(".dropdown1_label").text("All Community");
        } else {
          $.each(app_choices.split(","), function (i, val) {
            $("input[value='" + val + "']").prop('checked', true);
          });
          var selected = [];
          $('.dropdown-menu input:checked').each(function() {
            selected.push($(this).attr('name'));
          });
          $(".dropdown1_label").text(selected);
        }
      }

      $('.borderless_tab_controls a').click(function (e) {
        e.preventDefault();
        e.stopImmediatePropagation();
        $(this).tab('show');
        $.cookie('cmty_lp_tab_pref', $(this).attr('name'), {path: '/'});
      });

      //cookie preference for tab selection
      var pref = $.cookie('cmty_lp_tab_pref');
      if(pref == "") {
        set_default_tab_pref();
      }
      var tab_pref = $.cookie('cmty_lp_tab_pref');
      var filter_element = "";
      var content_pane = "";
      if (tab_pref == 'mlc-recommendations') {
        filter_element = "#filter_recommendation";
        content_pane = "#tab_recommendations";
      }
      if (tab_pref == 'mlc-trending') {
        filter_element = "#filter_trending";
        content_pane = "#tab_trending";
        $("#dropdown1").removeClass("disabled");
      }
      else if(tab_pref == 'mlc-newest') {
        filter_element = "#filter_new";
        content_pane = "#tab_new";
        $("#dropdown1").removeClass("disabled");
      }
      else if(tab_pref == 'mlc-activity') {
          filter_element = "#filter_activity";
          content_pane = "#tab_activities";
      }
      else {
        filter_element = "#filter_recommendation";
        content_pane = "#tab_recommendations";
      }

      $(filter_element).addClass('active');
      $('.tab-content ' + content_pane).addClass('active');

      function set_default_tab_pref() {
       $.cookie('cmty_lp_tab_pref', 'mlc-recommendations', {path: '/'});
      }

      function onRecommendationActive() {
        $('#filter_recommendation').addClass('active');
        $('#filter_new').removeClass('active');
        $('#filter_trending').removeClass('active');
        $('#filter_activity').removeClass('active');
        $('#tab_new').removeClass('active');
        $('#tab_trending').removeClass('active');
        $('#tab_activities').removeClass('active');
      }

      function onNewActive() {
        $('#filter_recommendation').removeClass('active');
        $('#filter_new').addClass('active');
        $('#filter_trending').removeClass('active');
        $('#filter_activity').removeClass('active');
        $('#tab_recommendations').removeClass('active');
        $('#tab_trending').removeClass('active');
        $('#tab_activities').removeClass('active');
      }

      function onTrendingActive() {
        $('#filter_recommendation').removeClass('active');
        $('#filter_new').removeClass('active');
        $('#filter_trending').addClass('active');
        $('#filter_activity').removeClass('active');
        $('#tab_recommendations').removeClass('active');
        $('#tab_new').removeClass('active');
        $('#tab_activities').removeClass('active');
      }

      function onActivityActive() {
        $('#filter_recommendation').removeClass('active');
        $('#filter_new').removeClass('active');
        $('#filter_trending').removeClass('active');
        $('#filter_activity').addClass('active');
        $('#tab_recommendations').removeClass('active');
        $('#tab_new').removeClass('active');
        $('#tab_trending').removeClass('active');
      }

      // Set up the MutationObservers for active tab
      const targetNode1 = document.getElementById('mlc-recommendation-tab');
      const observerConfig1 = { attributes: true, attributeFilter: ['class'] };     
      const observer1 = new MutationObserver((mutationsList) => {
        for (let mutation of mutationsList) {
          if (mutation.type === 'attributes' && $(targetNode1).hasClass('active')) { onRecommendationActive(); }
        }
      });
      observer1.observe(targetNode1, observerConfig1);

      const targetNode2 = document.getElementById('mlc-new-tab');
      const observerConfig2 = { attributes: true, attributeFilter: ['class'] };     
      const observer2 = new MutationObserver((mutationsList) => {
        for (let mutation of mutationsList) {
          if (mutation.type === 'attributes' && $(targetNode2).hasClass('active')) { onNewActive(); }
        }
      });
      observer2.observe(targetNode2, observerConfig2);

      const targetNode3 = document.getElementById('mlc-trending-tab');
      const observerConfig3 = { attributes: true, attributeFilter: ['class'] };     
      const observer3 = new MutationObserver((mutationsList) => {
        for (let mutation of mutationsList) {
          if (mutation.type === 'attributes' && $(targetNode3).hasClass('active')) { onTrendingActive(); }
        }
      });
      observer3.observe(targetNode3, observerConfig3);

      const targetNode4 = document.getElementById('mlc-activity-tab');
      const observerConfig4 = { attributes: true, attributeFilter: ['class'] };     
      const observer4 = new MutationObserver((mutationsList) => {
        for (let mutation of mutationsList) {
          if (mutation.type === 'attributes' && $(targetNode4).hasClass('active')) { onActivityActive(); }
        }
      });
      observer4.observe(targetNode4, observerConfig4);

      setTimeout(function() {
        var appList = new Array();

        $(".recommendation_card .post_meta a:nth-of-type(2)").each(function (i) {
          var app_name = $(this).text().replace(/ /g, '').toLowerCase()
          appList.push(app_name);
        })

        var map = appList.reduce(function(obj, b) {
          obj[b] = ++obj[b] || 1;
          return obj;
        }, {});

        //adding next two lines to support label change of Answers content from Answers to MATLAB Answers
        map['answers'] = map['matlabanswers']
        delete(map['matlabanswers']);

        var allowed_key = ['answers', 'fileexchange', 'cody', 'blogs'];

        var filtered = Object.keys(map)
          .filter(key => allowed_key.includes(key))
          .reduce((obj, key) => {
            obj[key] = map[key];
            return obj;
          }, {});

        var app_data = JSON.stringify(filtered);

        $.post('/matlabcentral/profile/api/v1/recapp/ping', {apps_data: app_data});
      }, 2000);
    });


    window.onload = function(){
      loadProfileScript();
    };
    function loadProfileScript() {
      const script = document.createElement("script");
      const domain = window.location.origin;
      script.src = domain + "/matlabcentral/profile/jscript/profile_card_v1.5.js";
      script.setAttribute("data-locale", "en");
      script.async = true;
      document.body.appendChild(script);
    }
    </script>




			
    
<link rel="stylesheet" href="/etc.clientlibs/mathworks/clientlibs/customer-ui/components/matrixmenu.min.20260902221426407.css" type="text/css">
<script src="/etc.clientlibs/mathworks/clientlibs/customer-ui/components/matrixmenu.min.20260902221426407.js"></script>
<script type="text/javascript" nonce="299e70c850571094c683ee72b28c3765" src="/ToUX1MY4KWXx47mRP0MK/1iOuhpQVSbQ2hX/aG4BHUZtAQ/FkI/KZ0l7UGA"></script><script type="text/javascript" nonce="299e70c850571094c683ee72b28c3765" src="/ToUX1MY4KWXx47mRP0MK/fNOuhpiD/ZR8IHUZtAQ/W09/KTw5sOjI4?v=8662c230-09aa-c269-6a6b-b734f180172f" defer></script></body>
