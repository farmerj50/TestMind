<script src="https://www.mathworks.com/matlabcentral/jscript/userarea-typeahead-v1.js"></script>
<script type="text/javascript">
  document.addEventListener("DOMContentLoaded", function () {
    const quickLinks = [
        { text: "How to ask a good question", link: "/matlabcentral/answers/help/?s_tid=ta_ans_quicklinks_ask#ask" },
        { text: "View MATLAB FAQs", link: "/matlabcentral/answers/faqs/?s_tid=ta_ans_quicklinks_faqs" },
        { text: "How to search", link: "/matlabcentral/answers/help/?s_tid=ta_ans_quicklinks_search#search" }
    ];
    const possibleSelectors = ['#query', '#answerssearch', '#lp_answerssearch'];
    possibleSelectors.forEach(selector => {
      const inputElement = document.querySelector(selector);
      if (inputElement) {
        const customElement = document.createElement('userarea-typeahead');
        customElement.setAttribute('input-selector', selector);
        customElement.setAttribute('collection', 'answers');
        customElement.setAttribute('app-label', 'Answers');
        customElement.setAttribute('env', 'prod');
        customElement.setAttribute('site-language', 'en');
        customElement.setAttribute('blank-state', 'true');
        customElement.setAttribute('quick-links', JSON.stringify(quickLinks));
        document.body.appendChild(customElement);
      }
    });
  });
</script>
