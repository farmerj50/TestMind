<script src="/matlabcentral/answers/assets/search-9da8b9e0ef133442d8f750362c52a4d9453b0f61788dec79ffab57b959487ef6.js"></script>
<script src="/matlabcentral/answers/assets/landing-331b586ad6cbef559b3fcfdd229a46be1510e43f70b8776e66f0dc1f52b56ff5.js"></script>
<script type="text/javascript">
  insert_search_origin("ans_lp");

  addFeedClickListeners();

  var pref = get_feed_cookie_pref();
  if (!is_feed_cookie_value_valid(pref) || is_activity_feed_selected_and_unavailable(pref)) {
    pref = "Trending";    
  }

  // this feed selection will be overriden by a DOMContentLoaded event listener external to Answers 
  // this selection stays only if loading of the recommendations feed items errors
  select_feed(pref.toLowerCase(), true);

  fetch_feed_page('trendy', '1')
  fetch_feed_page('new', '1')
    
  fetch_feed_page('activity', '1')

  var profile_id = "42269956";
  var profile_summary_url = "/matlabcentral/profile/api/v1/profile_summary/" + profile_id;
  var url = "/matlabcentral/profile/api/v1/earned_badges?app_id=2/" + "&profile_id=" + profile_id + "&max_per_page=5";

  get_profile_rank(profile_summary_url);

  updateBadgeData(
    url,
    '/matlabcentral/profile/authors/42269956/badges/?s_tid=ans_lp_more_badges',
    '/matlabcentral/profile/badges/28/?s_tid=ans_lp_first_badge',
    '/matlabcentral/profile/badges/First_Answer.png',
    'Earn your first badge'
  );
</script>
