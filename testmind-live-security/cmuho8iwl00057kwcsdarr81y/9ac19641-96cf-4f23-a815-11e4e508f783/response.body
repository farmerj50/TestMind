dn.etorostatic.com/market-avatars/336/336_FF663D_F7F7F7.svg","backgroundColor":"#FF663D","textColor":"#F7F7F7"}},"application":"eToro","metadata":"","assetTypeId":2,"assetTypeSubCategoryId":0}},{"market":{"id":"557","symbolName":"IronOre","displayName":"Iron Ore","updated":"2026-09-26T01:21:38.628Z","assetType":"CommodityMetals","internalId":557,"avatar":{"small":"https://etoro-cdn.etorostatic.com/market-avatars/557/35x35.png","medium":"https://etoro-cdn.etorostatic.com/market-avatars/557/50x50.png","large":"https://etoro-cdn.etorostatic.com/market-avatars/557/150x150.png","svg":{"url":"https://etoro-cdn.etorostatic.com/market-avatars/557/557_AAAAAA_F7F7F7.svg","backgroundColor":"#AAAAAA","textColor":"#F7F7F7"}},"application":"eToro","metadata":"","assetTypeId":2,"assetTypeSubCategoryId":0}}],"isSpam":false,"editStatus":"None"},"commentsData":{"reactionPaging":{"totalCount":0},"comments":[]},"emotionsData":{"like":{"paging":{"totalCount":1},"emotions":[{"type":"Like","id":"like_2ecbb910-b89f-11f1-8080-80000217cb85_12564565","owner":{"id":"12564565","username":"FxTradeFx","firstName":"Lars","lastName":"Nietzschmann","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/12276068/5.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/12276068/5.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/12276068/5.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":79,"piLevel":2,"isProInvestor":false,"badgeType":"Pi"},"parent":{"id":"2ecbb910-b89f-11f1-8080-80000217cb85","obsoleteId":"2ecbb910-b89f-11f1-8080-80000217cb85","type":"Post"},"created":"2026-09-25T18:55:16.127Z"}]}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":true,"isOwner":false},"summary":{"totalCommentsAndReplies":0,"sharedCount":0}},{"id":"effe9050-b89d-11f1-8080-80011cfcc10b","post":{"id":"effe9050-b89d-11f1-8080-80011cfcc10b","owner":{"id":"318149","username":"eToroTeam","firstName":"eToro","lastName":"Team","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/918269/11.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/918269/11.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/918269/11.jpg"},"roles":["eTorian","Analyst","Verified","Regular","Admin","Moderator","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":250,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"obsoleteId":"26db59e5-e292-4bc7-a3a8-f0c0f3cd0916","created":"2026-09-25T04:59:50.101Z","message":{"text":"📢 $EU (Encore Energy Corp) Spin-off 📢\n\nWe would like to bring to your attention a recent spin-off event on Encore Energy Corp - $EU\n\n⚠️ A spin-off is the creation of an independent company through the sale or distribution of new shares of an existing business or division of a parent company.\n\n👉 How will eToro handle this spin-off event?\n\n1️⃣Users holding BUY positions in the underlying asset will receive shares in the underlying asset of the spun-off company relative to the terms of the event.\n\nTo receive shares in the spun-off company, you’ll need to update your W-8BEN via the eToro platform. If it’s not up-to-date when the shares are distributed, you will receive the cash equivalent instead ➡ www.etoro.com/watchlists?tion=fin&deepLink=w8ben&intro=true\n\n2️⃣Users holding a CFD BUY position will receive a cash equivalent relevant to the event terms.\n\n3️⃣For users holding a SELL position the proportional cash amount will be taken from their available balance.\n\n⚠IMPORTANT!\n\nAs the parent company's value will change in response to the spin-off event, some positions may close.\n\nCFD positions that close with a loss in excess of the invested amount will show a close rate that equates to zero value and any loss beyond the invested amount will be deducted from the cash equivalent that represents the spun-off company.\n\n\nThank you,\n\nThe eToroTeam","languageCode":"en-gb"},"updated":"2026-09-25T04:59:50.101Z","isDeleted":false,"type":"Default","metadata":{},"attachments":[{"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/f7710222-62b4-4011-9a9a-545b81fe3843-2026-09-25.png","host":"openbook-static-files-prod.s3.amazonaws.com","mediaType":"Image","media":{"image":{"width":1200,"height":628,"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/f7710222-62b4-4011-9a9a-545b81fe3843-2026-09-25.png"},"video":{"videoSource":"None","image":{"width":0,"height":0}}}}],"isSpam":false,"editStatus":"None"},"commentsData":{"reactionPaging":{"totalCount":0},"comments":[]},"emotionsData":{"like":{"paging":{"totalCount":1},"emotions":[{"type":"Like","id":"like_effe9050-b89d-11f1-8080-80011cfcc10b_12564565","owner":{"id":"12564565","username":"FxTradeFx","firstName":"Lars","lastName":"Nietzschmann","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/12276068/5.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/12276068/5.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/12276068/5.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":79,"piLevel":2,"isProInvestor":false,"badgeType":"Pi"},"parent":{"id":"effe9050-b89d-11f1-8080-80011cfcc10b","obsoleteId":"effe9050-b89d-11f1-8080-80011cfcc10b","type":"Post"},"created":"2026-09-25T18:55:19.449Z"}]}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":true,"isOwner":false},"summary":{"totalCommentsAndReplies":0,"sharedCount":0}},{"id":"76c9d0f0-b89d-11f1-8080-800114ab53d4","post":{"id":"76c9d0f0-b89d-11f1-8080-800114ab53d4","owner":{"id":"318149","username":"eToroTeam","firstName":"eToro","lastName":"Team","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/918269/11.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/918269/11.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/918269/11.jpg"},"roles":["eTorian","Analyst","Verified","Regular","Admin","Moderator","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":250,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"obsoleteId":"f799a00b-154d-470b-a936-bceeb7bd00c9","created":"2026-09-25T04:56:26.751Z","message":{"text":"📣📣 REVERSE SPLIT ALERT\n\nPlease note, there has been a reverse stock split on the following stocks:\n\n● Cynca Nordic AB - $CYNCA\nThe ratio for the split is 1 for 10\n\n● Nauticus Robotics Inc - $KITT\nThe ratio for the split is 1 for 6\n\n● Republic Power Group Ltd - $RPGL\nThe ratio for the split is 1 for 16\n\n👉 What is a reverse stock split?\n\nA reverse split is a market event where a company decides to consolidate its existing shares into fewer, proportionally more valuable, shares. The process involves a company reducing the total number of its outstanding shares in the open market according to a certain ratio. For example: if the split ratio is 1:2, then for every two shares previously held, shareholders would now hold a single share. Subsequently, the price of the share is also adjusted according to the same ratio in order to maintain the same overall value.\n\n👉 How do we respond to a stock split?\n\nOur policy in response to a split is to adjust the opening rate of the positions in question to reflect the new rates. This also ensures that all subsequent profit calculations are proportionately correct.\n\nPlease be aware that any price changes for the above-mentioned stocks, as well as changes in holdings of units, are due to this adjustment. 🔊\n\nTo sum it up, the price of the assets and the number of units on the positions may change, but the value of all relevant positions remains the same.\n\n\nThank you,\n\nThe eToroTeam","languageCode":"en-gb"},"updated":"2026-09-25T04:56:26.751Z","isDeleted":false,"type":"Default","metadata":{},"attachments":[{"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/670fd89e-4009-46d9-a2a4-f12446e820d0-2026-09-25.png","host":"openbook-static-files-prod.s3.amazonaws.com","mediaType":"Image","media":{"image":{"width":1200,"height":628,"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/670fd89e-4009-46d9-a2a4-f12446e820d0-2026-09-25.png"},"video":{"videoSource":"None","image":{"width":0,"height":0}}}}],"isSpam":false,"editStatus":"None"},"commentsData":{"reactionPaging":{"totalCount":0},"comments":[]},"emotionsData":{"like":{"paging":{"totalCount":1},"emotions":[{"type":"Like","id":"like_76c9d0f0-b89d-11f1-8080-800114ab53d4_12564565","owner":{"id":"12564565","username":"FxTradeFx","firstName":"Lars","lastName":"Nietzschmann","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/12276068/5.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/12276068/5.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/12276068/5.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":79,"piLevel":2,"isProInvestor":false,"badgeType":"Pi"},"parent":{"id":"76c9d0f0-b89d-11f1-8080-800114ab53d4","obsoleteId":"76c9d0f0-b89d-11f1-8080-800114ab53d4","type":"Post"},"created":"2026-09-25T18:55:20.9Z"}]}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":true,"isOwner":false},"summary":{"totalCommentsAndReplies":0,"sharedCount":0}},{"id":"f65b2f30-b7e9-11f1-8080-800056888027","post":{"id":"f65b2f30-b7e9-11f1-8080-800056888027","owner":{"id":"318149","username":"eToroTeam","firstName":"eToro","lastName":"Team","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/918269/11.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/918269/11.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/918269/11.jpg"},"roles":["eTorian","Analyst","Verified","Regular","Admin","Moderator","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":250,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"obsoleteId":"f6dfb8a7-7565-486e-ac5e-91efeb2a26a0","created":"2026-09-24T07:31:31.363Z","message":{"text":"🚨 𝐈𝐦𝐩𝐨𝐫𝐭𝐚𝐧𝐭 𝐍𝐨𝐭𝐢𝐜𝐞 - 𝐃𝐞𝐥𝐢𝐬𝐭𝐢𝐧𝐠 of the following stock due to a merger/acquisition (M&A):\n\n● Theravance Biopharma Inc - $TBPH\n\nThe above-mentioned stock was recently involved in a merger/acquisition and will be delisted from the exchange.\n\nA merger involves the combination of two companies into a single new entity. Various types of mergers are executed for different reasons, such as expanding a company's presence in new sectors or gaining market share. The ultimate goal behind such mergers and acquisitions is to enhance shareholder value.\n\nIf the aforementioned stock is the acquired party, then it will be delisted from the platform, and positions will be closed at the average liquidation price. If the aforementioned stock is the acquirer, it will continue to be offered on our platform.\n\nPlease be aware that corporate actions may be subject to changes.\n\nTo review your account portfolio and stay informed about any updates, please click here: https://www.etoro.com/portfolio/overview\n\n\nThank you,\n\nThe eToroTeam","languageCode":"en-gb"},"updated":"2026-09-24T07:31:31.363Z","isDeleted":false,"type":"Default","metadata":{},"attachments":[{"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/7c799b3d-2810-4938-9aa6-76bf0544ad2e-2026-09-24.png","host":"openbook-static-files-prod.s3.amazonaws.com","mediaType":"Image","media":{"image":{"width":1200,"height":628,"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/7c799b3d-2810-4938-9aa6-76bf0544ad2e-2026-09-24.png"},"video":{"videoSource":"None","image":{"w