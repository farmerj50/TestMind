{"discussions":[{"id":"6011e790-b8ba-11f1-8080-80002ed9c48c","post":{"id":"6011e790-b8ba-11f1-8080-80002ed9c48c","owner":{"id":"318149","username":"eToroTeam","firstName":"eToro","lastName":"Team","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/918269/11.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/918269/11.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/918269/11.jpg"},"roles":["eTorian","Analyst","Verified","Regular","Admin","Moderator","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":250,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"obsoleteId":"1fe68b48-7925-4826-9877-3e56440be934","created":"2026-09-25T08:23:24.041Z","message":{"text":"Our next Ask Me Anything is coming up - and this time, the eToro Community Team is in the hot seat. \n\nWe’re the eToro Community Team you see across the eToro Feed, our active social channels and other community spaces - answering questions, responding to feedback, sharing important updates and connecting users with the relevant teams.\n\nFor one hour, we’ll be live in the comments answering your questions about:\n\n- How we handle user questions and feedback\n- What happens when you report an issue\n- How feedback is shared with Product and other teams\n- How we choose community topics and discussions\n- Corporate actions, IPOs and platform announcements\n- Moderation and managing community conversations\n- What it’s like to work directly with the eToro community\n\nThis is your chance to ask the people behind the conversations anything about the Community Team and how we help connect eToro users with the company.\n\n📅 Monday, September 28, 2026\n🕛 12 PM GMT\n\nNo registration required. Just head to the @eToroTeam Feed when we go live. We’ll also send a push notification when the AMA starts, so you won’t miss it.\n\nStart thinking about your questions.\n\n— The eToro Team","languageCode":"en-gb"},"updated":"2026-09-25T08:23:24.041Z","isDeleted":false,"type":"Default","metadata":{},"attachments":[{"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/c4906b8c-6476-4bc3-b8fe-71ad29d2684b-2026-09-25.png","host":"openbook-static-files-prod.s3.amazonaws.com","mediaType":"Image","media":{"image":{"width":2400,"height":1256,"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/c4906b8c-6476-4bc3-b8fe-71ad29d2684b-2026-09-25.png"},"video":{"videoSource":"None","image":{"width":0,"height":0}}}}],"mentions":[{"user":{"id":"318149","username":"eToroTeam","firstName":"eToro","lastName":"Team","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/918269/11.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/918269/11.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/918269/11.jpg"},"roles":["eTorian","Analyst","Verified","Regular","Admin","Moderator","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":250,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"isDirect":false}],"isSpam":false,"editStatus":"None"},"commentsData":{"reactionPaging":{"totalCount":24},"comments":[{"entity":{"message":{"text":"$ETOR ","languageCode":"eu"},"attachments":[{"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/krejzekemil/241bc0b1-6060-4026-9856-3038de903c66-2026-09-25.jpeg","host":"openbook-static-files-prod.s3.amazonaws.com","mediaType":"Image","media":{"image":{"width":814,"height":1420,"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/krejzekemil/241bc0b1-6060-4026-9856-3038de903c66-2026-09-25.jpeg"},"video":{"videoSource":"None","image":{"width":0,"height":0}}}}],"tags":[{"market":{"id":"12200","symbolName":"ETOR","displayName":"eToro Group LTD","updated":"2026-09-25T23:48:20.715Z","assetType":"Stocks","internalId":12200,"avatar":{"small":"https://etoro-cdn.etorostatic.com/market-avatars/12200/35x35.png","medium":"https://etoro-cdn.etorostatic.com/market-avatars/12200/