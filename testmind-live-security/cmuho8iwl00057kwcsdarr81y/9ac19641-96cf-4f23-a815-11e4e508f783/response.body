isOwner":false},"replies":[]},{"entity":{"message":{"text":"Etf","languageCode":"en-gb"},"attachments":[],"isSpam":false,"editStatus":"None","id":"4672207a-f607-4eec-b64d-ab578ce95710","owner":{"id":"19560415","username":"averyniceweather","avatar":{"small":"https://etoro-cdn.etorostatic.com/images/avatoros/35x35/de.png","medium":"https://etoro-cdn.etorostatic.com/images/avatoros/50x50/de.png","large":"https://etoro-cdn.etorostatic.com/images/avatoros/150x150/de.png"},"roles":["Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":true,"countryCode":79,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"obsoleteId":"4672207a-f607-4eec-b64d-ab578ce95710","parent":{"id":"6011e790-b8ba-11f1-8080-80002ed9c48c","obsoleteId":"6011e790-b8ba-11f1-8080-80002ed9c48c","type":"Post"},"created":"2026-09-25T15:06:10.073Z"},"repliesCount":0,"emotionsData":{"like":{"paging":{"totalCount":0}}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":false,"isOwner":false},"replies":[]},{"entity":{"message":{"text":"في ظل الاوضاع جو سياسية التي يشهدها الشرق الاوسط والحرب الوكرانية  وحمى الحمائية - الضرائب - ورفع الفائدة من قبل الفيدرالي وقوة الدولار  الى اين يسير الذهب .","languageCode":"ar-ae"},"attachments":[],"isSpam":false,"editStatus":"None","id":"8db0cd58-75be-4f46-bd2f-cc5a9a583d7c","owner":{"id":"19957936","username":"sultanalsiyabi","avatar":{"small":"https://etoro-cdn.etorostatic.com/images/avatoros/35x35/om.png","medium":"https://etoro-cdn.etorostatic.com/images/avatoros/50x50/om.png","large":"https://etoro-cdn.etorostatic.com/images/avatoros/150x150/om.png"},"roles":["Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":true,"countryCode":155,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"obsoleteId":"8db0cd58-75be-4f46-bd2f-cc5a9a583d7c","parent":{"id":"6011e790-b8ba-11f1-8080-80002ed9c48c","obsoleteId":"6011e790-b8ba-11f1-8080-80002ed9c48c","type":"Post"},"created":"2026-09-25T14:43:02.723Z"},"repliesCount":1,"emotionsData":{"like":{"paging":{"totalCount":1},"emotions":[{"type":"Like","id":"like_8db0cd58-75be-4f46-bd2f-cc5a9a583d7c_23034699","owner":{"id":"23034699","username":"Peppe1234567","firstName":"Giuseppe","lastName":"Verderosa","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/22751432/7.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/22751432/7.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/22751432/7.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":102,"piLevel":2,"isProInvestor":false,"badgeType":"Pi"},"parent":{"parent":{"id":"6011e790-b8ba-11f1-8080-80002ed9c48c","obsoleteId":"6011e790-b8ba-11f1-8080-80002ed9c48c","type":"Post"},"id":"8db0cd58-75be-4f46-bd2f-cc5a9a583d7c","obsoleteId":"8db0cd58-75be-4f46-bd2f-cc5a9a583d7c","type":"Comment"},"created":"2026-09-25T15:58:32.292Z"}]}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":false,"isOwner":false},"replies":[]},{"entity":{"message":{"text":"Transparency from the team is a massive value driver; understanding how feedback shapes the platform is just as critical as fundamental market analysis.","languageCode":"en-gb"},"attachments":[],"isSpam":false,"editStatus":"None","id":"fd95b972-4262-446b-a900-a2ec80a5e9cd","owner":{"id":"6080261","username":"cristian1017","firstName":"Cristian","lastName":"Salazar","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/5796241/7.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/5796241/7.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/5796241/7.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":47,"piLevel":2,"isProInvestor":false,"badgeType":"Pi"},"obsoleteId":"fd95b972-4262-446b-a900-a2ec80a5e9cd","parent":{"id":"6011e790-b8ba-11f1-8080-80002ed9c48c","obsoleteId":"6011e790-b8ba-11f1-8080-80002ed9c48c","type":"Post"},"created":"2026-09-25T14:10:31.156Z"},"repliesCount":0,"emotionsData":{"like":{"paging":{"totalCount":1},"emotions":[{"type":"Like","id":"like_fd95b972-4262-446b-a900-a2ec80a5e9cd_28036429","owner":{"id":"28036429","username":"KrejzekEmil","firstName":"Emil","lastName":"Krejzek","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/27753756/13.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/27753756/13.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/27753756/13.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":55,"piLevel":2,"isProInvestor":false,"badgeType":"Pi"},"parent":{"parent":{"id":"6011e790-b8ba-11f1-8080-80002ed9c48c","obsoleteId":"6011e790-b8ba-11f1-8080-80002ed9c48c","type":"Post"},"id":"fd95b972-4262-446b-a900-a2ec80a5e9cd","obsoleteId":"fd95b972-4262-446b-a900-a2ec80a5e9cd","type":"Comment"},"created":"2026-09-25T20:26:06.066Z"}]}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":false,"isOwner":false},"replies":[]},{"entity":{"message":{"text":"Can someone explain why so many people end up copying people who’ve only been around for a few years, in an absurdly bullish market, instead of analyzing a whole set of parameters or even reading their biographies carefully? The truth is that many imitate simply because it’s easier to follow someone who just got lucky rather than actually evaluate their competence and in a market like this, anyone looks like a genius. Ciaoo","languageCode":"en-gb"},"attachments":[],"isSpam":false,"editStatus":"None","id":"e5ba54e8-2271-4875-bf85-511c07d4efe4","owner":{"id":"23034699","username":"Peppe1234567","firstName":"Giuseppe","lastName":"Verderosa","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/22751432/7.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/22751432/7.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/22751432/7.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":102,"piLevel":2,"isProInvestor":false,"badgeType":"Pi"},"obsoleteId":"e5ba54e8-2271-4875-bf85-511c07d4efe4","parent":{"id":"6011e790-b8ba-11f1-8080-80002ed9c48c","obsoleteId":"6011e790-b8ba-11f1-8080-80002ed9c48c","type":"Post"},"created":"2026-09-25T13:40:31.287Z"},"repliesCount":0,"emotionsData":{"like":{"paging":{"totalCount":1},"emotions":[{"type":"Like","id":"like_e5ba54e8-2271-4875-bf85-511c07d4efe4_28036429","owner":{"id":"28036429","username":"KrejzekEmil","firstName":"Emil","lastName":"Krejzek","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/27753756/13.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/27753756/13.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/27753756/13.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":55,"piLevel":2,"isProInvestor":false,"badgeType":"Pi"},"parent":{"parent":{"id":"6011e790-b8ba-11f1-8080-80002ed9c48c","obsoleteId":"6011e790-b8ba-11f1-8080-80002ed9c48c","type":"Post"},"id":"e5ba54e8-2271-4875-bf85-511c07d4efe4","obsoleteId":"e5ba54e8-2271-4875-bf85-511c07d4efe4","type":"Comment"},"created":"2026-09-25T20:25:58.952Z"}]}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":false,"isOwner":false},"replies":[]},{"entity":{"message":{"text":"Spero che la mia domanda avrà una risposta: Quando tornerà a funzionare il Volume Profile Fixed Range sul mio grafico per le criptovalute?","languageCode":"it-it"},"attachments":[],"isSpam":false,"editStatus":"None","id":"e943be88-8232-4a88-9c95-329884376c72","owner":{"id":"27074522","username":"crnadgn","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/26791858/4.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/26791858/4.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/26791858/4.jpg"},"roles":["Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":true,"countryCode":102,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"obsoleteId":"e943be88-8232-4a88-9c95-329884376c72","parent":{"id":"6011e790-b8ba-11f1-8080-80002ed9c48c","obsoleteId":"6011e790-b8ba-11f1-8080-80002ed9c48c","type":"Post"},"created":"2026-09-25T13:29:26.677Z"},"repliesCount":0,"emotionsData":{"like":{"paging":{"totalCount":0}}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":false,"isOwner":false},"replies":[]},{"entity":{"message":{"text":"I honestly think the previous feed system worked much better. eToro now says the feed is supposed to be better personalized and show content that is more relevant to each user, but in my experience, it often feels like the opposite.\n\nMy feed is constantly filled with posts from people I don’t follow and whose content I’m simply not interested in. Some users post several times a day, which ends up flooding the feed and makes it much harder to find the genuinely useful market analysis and insights shared by traders I actually chose to follow.\n\nCould you please give users more control over their feed? Ideally, we should have the option to see only the people we follow, or at least strongly prioritize them, while keeping recommended content as an optional feature.\n\nThere are many traders on eToro who share valuable analysis and well-written posts. I would much rather spend my time reading their content than constantly scrolling through unrelated recommendations.\n\nAre you planning to give users more control over who appears in their feed and bring back a true “Following only” option?","languageCode":"en-gb"},"attachments":[],"isSpam":false,"editStatus":"None","id":"de4378a9-d7b3-4697-851f-e313b5c1083d","owner":{"id":"22186394","username":"elnuns","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/21902966/2.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/21902966/2.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/21902966/2.jpg"},"roles":["Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":true,"countryCode":197,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"obsoleteId":"de4378a9-d7b3-4697-851f-e313b5c1083d","parent":{"id":"6011e790-b8ba-11f1-8080-80002ed9c48c","obsoleteId":"6011e790-b8ba-11f1-8080-80002ed9c48c","type":"Post"},"created":"2026-09-25T13:26:22.379Z"},"repliesCount":0,"emotionsData":{"like":{"paging":{"totalCount":1},"emotions":[{"type":"Like","id":"like_de4378a9-d7b3-4697-851f-e313b5c1083d_28036429","owner":{"id":"28036429","username":"KrejzekEmil","firstName":"Emil","lastName":"Krejzek","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/27753756/13.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/27753756/13.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/27753756/13.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":55,"piLevel":2,"isProInvestor":false,"badgeType":"Pi"},"parent":{"parent":{"id":"6011e790-b8ba-11f1-8080-80002ed9c48c","obsoleteId":"6011e790-b8ba-11f1-8080-80002ed9c48c","type":"Post"},"id":"de4378a9-d7b3-4697-851f-e313b5c1083d","obsoleteId":"de4378a9-d7b3-4697-851f-e313b5c1083d","type":"Comment"},"created":"2026-09-25T20:25:30.971Z"}]}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false