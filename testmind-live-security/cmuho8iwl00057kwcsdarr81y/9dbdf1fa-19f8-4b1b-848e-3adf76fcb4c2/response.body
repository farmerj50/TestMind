evel":2,"isProInvestor":false,"badgeType":"Pi"},"parent":{"id":"80cad520-b688-11f1-8080-8001104f881a","obsoleteId":"80cad520-b688-11f1-8080-8001104f881a","type":"Post"},"created":"2026-09-22T16:12:39.052Z"},{"type":"Like","id":"like_80cad520-b688-11f1-8080-8001104f881a_43207807","owner":{"id":"43207807","username":"skyholding25","firstName":"Alessandro","lastName":"Sakyi Alfred","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/43077387/4.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/43077387/4.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/43077387/4.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":102,"piLevel":2,"isProInvestor":false,"badgeType":"Pi"},"parent":{"id":"80cad520-b688-11f1-8080-8001104f881a","obsoleteId":"80cad520-b688-11f1-8080-8001104f881a","type":"Post"},"created":"2026-09-22T15:23:51.302Z"}]}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":true,"isOwner":false},"summary":{"totalCommentsAndReplies":0,"sharedCount":0},"additionalData":{"reliableRecAiAssets":[{"assetId":1003,"score":1.0}]}},{"id":"e32646a0-b688-11f1-8080-800175634ce3","post":{"id":"e32646a0-b688-11f1-8080-800175634ce3","owner":{"id":"318149","username":"eToroTeam","firstName":"eToro","lastName":"Team","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/918269/11.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/918269/11.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/918269/11.jpg"},"roles":["eTorian","Analyst","Verified","Regular","Admin","Moderator","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":250,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"obsoleteId":"19238296-b3c9-497e-8e44-14a8a6ff1139","created":"2026-09-22T13:24:06.794Z","message":{"text":"One strategy, three levels of exposure. Explore the AlphaMatriX family of Smart Portfolios and see how the same systematic approach can be expressed across different risk levels. 💡","languageCode":"en-gb"},"updated":"2026-09-22T13:24:06.794Z","isDeleted":false,"type":"Share","metadata":{"share":{"sharedOriginPost":{"id":"114194b0-b367-11f1-8080-80017cf064d2","owner":{"id":"32352485","username":"eToro-Portfolios","firstName":"Smart","lastName":"Portfolios Community","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/32087083/4.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/32087083/4.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/32087083/4.jpg"},"roles":["eTorian","Analyst","Verified","Regular","Moderator"],"isBlocked":false,"isPrivate":false,"countryCode":218,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"obsoleteId":"8c5321e9-4aee-44e8-a9f5-30f6b73a7baa","created":"2026-09-18T13:44:27.771Z","message":{"text":"🧠 One Strategy, Three Levels of Exposure\n\n@AlphaMatriX1-LS, @AlphaMatriX2-LS and @AlphaMatriX5-LS are three versions of the same systematic absolute-return strategy.\nThe strategy combines four return engines:\n\n↕️ Momentum long/short equities — targeting persistent trends in stronger and weaker stocks.\n⚖️ Sector-neutral stock selection — seeking company-specific opportunities while reducing broad sector exposure.\n🏛️ Treasury duration — adding an interest-rate-driven return source.\n🛡️ Tail-risk hedging — designed to help during severe market stress.\n\nPowered by proprietary AI models trained on eToro retail-flow data, the strategy is designed to seek alpha above the risk-free rate while maintaining relatively low dependence on broad equity-market direction.\n\nWhat changes between the three portfolios is not the investment process, but the level of exposure:\n@AlphaMatriX1-LS applies 1× exposure and represents the most conservative tier.\n@AlphaMatriX2-LS applies 2× exposure for a higher risk budget.\n@AlphaMatriX5-LS applies 5× exposure and represents the strongest expression of the strategy.\n\n💡 One interesting takeaway:\nThe AlphaMatriX family can be viewed as one investment engine with three different risk budgets.\n\nSame models. Same four strategic sleeves. Different levels of amplification.\n\n✨ All three portfolios rebalance monthly and have a minimum investment of $2,000.\n\n\nSmart Portfolios is a product that may include CFDs. 50% of retail investor accounts lose money when trading CFDs with this provider. Past performance is not an indication of future results.\n\n\n@eToro-Portfolios ","languageCode":"en-gb"},"updated":"2026-09-18T13:44:27.771Z","isDeleted":false,"type":"Default","metadata":{},"attachments":[{"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoro-portfolios/208d97fc-482c-45a7-a0a4-36cd99e822d7-2026-09-18.png","host":"openbook-static-files-prod.s3.amazonaws.com","mediaType":"Image","media":{"image":{"width":1200,"height":628,"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoro-portfolios/208d97fc-482c-45a7-a0a4-36cd99e822d7-2026-09-18.png"},"video":{"videoSource":"None","image":{"width":0,"height":0}}}}],"mentions":[{"user":{"id":"46059377","username":"AlphaMatriX1-LS","firstName":"AlphaMatriX","lastName":"Conservative","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/45973957/1.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/45973957/1.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/45973957/1.jpg"},"roles":["eTorian","CopyPortfolio","Verified","Regular"],"isBlocked":false,"isPrivate":false,"countryCode":102,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"isDirect":false},{"user":{"id":"46059409","username":"AlphaMatriX2-LS","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/45973989/3.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/45973989/3.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X