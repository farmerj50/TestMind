-prod.s3.amazonaws.com/rich-media/images/etoroteam/c3d5925b-8a92-47d3-9884-599540476c2a-2026-09-23.png","host":"openbook-static-files-prod.s3.amazonaws.com","mediaType":"Image","media":{"image":{"width":1200,"height":628,"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/c3d5925b-8a92-47d3-9884-599540476c2a-2026-09-23.png"},"video":{"videoSource":"None","image":{"width":0,"height":0}}}}],"tags":[{"market":{"id":"10348","symbolName":"INVE","displayName":"INVE Technologies Inc","updated":"2026-09-26T02:23:51.74Z","assetType":"Stocks","internalId":10348,"avatar":{"small":"https://etoro-cdn.etorostatic.com/market-avatars/10348/35x35.png","medium":"https://etoro-cdn.etorostatic.com/market-avatars/10348/50x50.png","large":"https://etoro-cdn.etorostatic.com/market-avatars/10348/150x150.png","svg":{"url":"https://etoro-cdn.etorostatic.com/market-avatars/10348/10348_CE202F_F7F7F7.svg","backgroundColor":"#CE202F","textColor":"#F7F7F7"}},"application":"eToro","metadata":"","assetTypeId":5,"assetTypeSubCategoryId":0}}],"isSpam":false,"editStatus":"None"},"commentsData":{"reactionPaging":{"totalCount":0},"comments":[]},"emotionsData":{"like":{"paging":{"totalCount":1},"emotions":[{"type":"Like","id":"like_3e58bed0-b70c-11f1-8080-80014956e333_12564565","owner":{"id":"12564565","username":"FxTradeFx","firstName":"Lars","lastName":"Nietzschmann","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/12276068/5.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/12276068/5.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/12276068/5.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":79,"piLevel":2,"isProInvestor":false,"badgeType":"Pi"},"parent":{"id":"3e58bed0-b70c-11f1-8080-80014956e333","obsoleteId":"3e58bed0-b70c-11f1-8080-80014956e333","type":"Post"},"created":"2026-09-25T18:56:41.625Z"}]}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":true,"isOwner":false},"summary":{"totalCommentsAndReplies":0,"sharedCount":0}},{"id":"995e66a0-b70b-11f1-8080-80007731dc31","post":{"id":"995e66a0-b70b-11f1-8080-80007731dc31","owner":{"id":"318149","username":"eToroTeam","firstName":"eToro","lastName":"Team","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/918269/11.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/918269/11.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/918269/11.jpg"},"roles":["eTorian","Analyst","Verified","Regular","Admin","Moderator","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":250,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"obsoleteId":"a409e381-e5eb-4df9-98c1-bff9c6fb35fa","created":"2026-09-23T04:59:47.082Z","message":{"text":"📣📣 REVERSE SPLIT ALERT\n\nPlease note, there has been a reverse stock split on the following stock:\n\n● Impact BioMedical Inc - $IBO\nThe ratio for the split is 0.0792 for 1\n\n\n👉 What is a reverse stock split?\n\nA reverse split is a market event where a company decides to consolidate its existing shares into fewer, proportionally more valuable, shares. The process involves a company reducing the total number of its outstanding shares in the open market according to a certain ratio. For example: if the split ratio is 1:2, then for every two shares previously held, shareholders would now hold a single share. Subsequently, the price of the share is also adjusted according to the same ratio in order to maintain the same overall value.\n\n👉 How do we respond to a stock split?\n\nOur policy in response to a split is to adjust the opening rate of the positions in question to reflect the new rates. This also ensures that all subsequent profit calculations are proportionately correct.\n\nPlease be aware that any price changes for the above-mentioned stock, as well as changes in holdings of units, are due to this adjustment. 🔊\n\nTo sum it up, the price of the asset and the number of units on the positions may change, but the value of all relevant positions remains the same.\n\n\nThank you,\n\nThe eToroTeam","languageCode":"en-gb"},"updated":"2026-09-23T04:59:47.082Z","isDeleted":false,"type":"Default","metadata":{},"attachments":[{"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/13c1f0ae-241b-4f48-b2b9-8106378c4b2e-2026-09-23.png","host":"openbook-static-files-prod.s3.amazonaws.com","mediaType":"Image","media":{"image":{"width":1200,"height":628,"url":"https://openbook-static-files-prod.s3.amazonaws.com/rich-media/images/etoroteam/13c1f0ae-241b-4f48-b2b9-8106378c4b2e-2026-09-23.png"},"video":{"videoSource":"None","image":{"width":0,"height":0}}}}],"isSpam":false,"editStatus":"None"},"commentsData":{"reactionPaging":{"totalCount":0},"comments":[]},"emotionsData":{"like":{"paging":{"totalCount":1},"emotions":[{"type":"Like","id":"like_995e66a0-b70b-11f1-8080-80007731dc31_12564565","owner":{"id":"12564565","username":"FxTradeFx","firstName":"Lars","lastName":"Nietzschmann","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/12276068/5.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/12276068/5.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/12276068/5.jpg"},"roles":["PI","Verified","Regular","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":79,"piLevel":2,"isProInvestor":false,"badgeType":"Pi"},"parent":{"id":"995e66a0-b70b-11f1-8080-80007731dc31","obsoleteId":"995e66a0-b70b-11f1-8080-80007731dc31","type":"Post"},"created":"2026-09-25T18:57:06.249Z"}]}},"requesterContext":{"isFlaggingAsSpam":false,"isSubscribed":false,"isLiking":false,"isSaved":false,"isPinned":false,"isRequesterBlocking":false,"isInteractionRestricted":false,"isFollowing":true,"isOwner":false},"summary":{"totalCommentsAndReplies":0,"sharedCount":0}},{"id":"80cad520-b688-11f1-8080-8001104f881a","post":{"id":"80cad520-b688-11f1-8080-8001104f881a","owner":{"id":"318149","username":"eToroTeam","firstName":"eToro","lastName":"Team","avatar":{"small":"https://etoro-cdn.etorostatic.com/avatars/35X35/918269/11.jpg","medium":"https://etoro-cdn.etorostatic.com/avatars/50X50/918269/11.jpg","large":"https://etoro-cdn.etorostatic.com/avatars/150X150/918269/11.jpg"},"roles":["eTorian","Analyst","Verified","Regular","Admin","Moderator","Depositor"],"isBlocked":false,"isPrivate":false,"countryCode":250,"piLevel":0,"isProInvestor":false,"badgeType":"None"},"obsoleteId":"22a1323f-4be1-4311-8278-07a258ae3e5f","created":"2026-09-22T13:21:21.778Z","message":{"text":"📊 WEEKLY ANALYST | Higher Rates, Bitcoin & Meta\n\n📈 Higher rates are back: The Federal Reserve raised interest rates by 25 basis points to 3.75%–4%, its first hike since 2023. With the 10-year Treasury yield near 5%, markets are facing renewed pressure from higher borrowing costs.\n\n🇺🇸 The S&P 500 faces a rate test: Strong earnings have helped equities absorb higher yields so far. But with the index up almost 12% this year, there may be less room for earnings disappointments.\n\n🤖 AI spending remains strong: Hyperscalers and AI infrastructure providers have raised around $225 billion in debt this year. Investors may want to focus on revenue growth, margins and cash flow—not capital spending alone.\n\n₿ Bitcoin faces key resistance: Bitcoin has moved above $80,000 and is approaching the $82,800 level, where the previous major sell-off began. A sustained breakout could attract further momentum, while $75,000 remains an important level to watch.\n\n📱 Meta reaches another test: $META (Meta Platforms) is facing resistance around $686 after gaining around 24% from its August low. A sustained break above this level could put its record high near $795 back in focus.\n\nBottom line: Higher rates are raising the bar for markets. Strong earnings may continue to support large-cap equities, but valuations, debt levels and profit expectations matter more as borrowing costs rise.\n\n\n📅 Earnings and events\n\n🗓️ Macro\n21 Sep UK Consumer Confidence\n22 Sep US Consumer Confidence\n\n📊 Earnings\n24 Sep Costco\n\nRead the full article by our eToro Analyst Lale Akoner ➡️ https://www.etoro.com/en-us/news-and-analysis/market-insights/higher-rates-are-back/ \n\nFor more information and updates on the markets, don’t forget to follow our eToro Analysts:\n\n@AntoineFraysse, @majorusa, @Analista-eToro, @jwesth, @xmolinaj, @JPvOudheusden, @joshgilbert9, @pmajtkowski, @samnorth7, @Nezatron, @Bretman\n\n– The eToro Team","languageCode":"en-gb"},"updated":"2026-09-22T13:21:21.778Z","isDeleted":false,"type":"Default","metadata":{},"attachments":[{"url":"https://www.etoro.com/en-us/news-and-analysis/market-insights/higher-rates-are-back/","title":"Higher Rates Return as Bitcoin and Meta Face Key Tests","host":"www.etoro.com","description":"The Fed resumes rate hikes as investors weigh 5% Treasury yields, earnings resilience, AI spending and portfolio risks, while Bitcoin and Meta approach crucial technical levels.","mediaType":"Link","media":{"image":{"width":1024,"height":538,"url":"https://www.etoro.com/wp-content/uploads/2025/11/analyst_weekly-1024_538-2026.jpg"},"video":{"videoSource":"None","image":{"width":0,"height":0}}}}],"tags":[{"market":{"id":"1003","symbolName":"META","displayName":"Meta Platforms Inc","updated":"2026-09-26T02:23:51.714Z","assetType":"Stocks","internalId":1003,"avatar":{"small":"/medium/FaceBook.png","medium":"https://etoro-cdn.etorostatic.com/market-avatars/fb/90x90.png","large":"https://etoro-cdn.etorostatic.com/market-avatars/1003/150x150.png","svg":{"url":"https://etoro-cdn.etorostatic.com/market-avatars/1003/1003_F7F7F7_2C2C2C.svg","backgroundColor":"#F7F7F7","textColor":"#2C2C2C"}},"application":"eToro","metadata":"","assetTypeId":5,"assetTypeSubCategoryId":0}}],"mentions":[{"user":{"id":"11130143","username":"AntoineFraysse","firstName":"Antoine","la